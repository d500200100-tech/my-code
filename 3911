local SKELETON_LINKS = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
}
local SKELETON_R6 = {
    {"Head","Torso"},{"Torso","Right Arm"},{"Right Arm","RightHand"},
    {"Torso","Left Arm"},{"Left Arm","LeftHand"},
    {"Torso","Right Leg"},{"Right Leg","RightFoot"},
    {"Torso","Left Leg"},{"Left Leg","LeftFoot"},
}

local SkeletonLines = {}
local function CreateSkeleton(player)
    if SkeletonLines[player] then return end
    local lines = {}
    for i = 1, #SKELETON_LINKS do
        local l = Drawing.new("Line")
        l.Thickness = Config.SkeletonThickness; l.Color = COLOR_SKEL; l.Visible = false
        table.insert(lines, l)
    end
    SkeletonLines[player] = lines
end

local function RemoveSkeleton(player)
    if SkeletonLines[player] then
        for _, l in ipairs(SkeletonLines[player]) do l:Remove() end
        SkeletonLines[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateSkeleton(p) end
end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then CreateSkeleton(p) end end)
Players.PlayerRemoving:Connect(function(p) RemoveSkeleton(p) end)

local function UpdateSkeleton(player, char, isTeam)
    local lines = SkeletonLines[player]
    if not lines then return end
    local links = SKELETON_LINKS
    if not char:FindFirstChild("UpperTorso") and char:FindFirstChild("Torso") then
        links = SKELETON_R6
    end
    local color = Config.SkeletonColorMode == "Team" and (isTeam and COLOR_TEAM or COLOR_MAIN) or COLOR_SKEL
    for i, link in ipairs(links) do
        local l = lines[i]
        if not l then break end
        local p1 = char:FindFirstChild(link[1])
        local p2 = char:FindFirstChild(link[2])
        if p1 and p2 then
            local v1, on1 = Camera:WorldToViewportPoint(p1.Position)
            local v2, on2 = Camera:WorldToViewportPoint(p2.Position)
            if on1 and on2 then
                l.From = Vector2.new(v1.X, v1.Y); l.To = Vector2.new(v2.X, v2.Y)
                l.Color = color; l.Thickness = Config.SkeletonThickness; l.Visible = true
            else l.Visible = false end
        else l.Visible = false end
    end
    for i = #links + 1, #lines do lines[i].Visible = false end
end

