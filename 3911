local function GetHealthData(char)
    if not char then return 100, 100 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function GetAimPart(char)
    if not char then return nil end
    local m = Config.AimTargetPart
    if m == "Head" then return char:FindFirstChild("Head")
    elseif m == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    else return char:FindFirstChild("HumanoidRootPart") end
end

local function GetClosestTarget(maxFOV, maxDist)
    maxDist = maxDist or Config.EspDistance
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not (Config.TeamCheck and p.Team == LocalPlayer.Team) then
            local char = p.Character
            if char then
                local h = char:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - myPos).Magnitude
                    if d <= maxDist then
                        local pos, onS = Camera:WorldToViewportPoint(h.Position)
                        if onS then
                            local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                            if mag <= maxFOV and mag < bd then
                                local hp = GetHealthData(char)
                                if hp > 0 then
                                    local ap = GetAimPart(char)
                                    if ap then bd = mag; best = ap end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local BotsCache = {}
local function IsPlayerChar(m) 
    if Players:GetPlayerFromCharacter(m) then return true end
    if m.Name:match("^Player") or (m.Parent and m.Parent.Name == "Players") then return true end
    if string.find(string.lower(m.Name), "sleeper") then return true end 
    return false 
end

local function RefreshBots()
    local l = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and not IsPlayerChar(o) then
            local hum = o:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and (o:FindFirstChild("HumanoidRootPart") or o:FindFirstChild("Head")) then
                table.insert(l, o)
            end
        end
    end
    BotsCache = l
end
task.spawn(function() RefreshBots(); while task.wait(3) do RefreshBots() end end)

local function GetBotHP(bot)
    if not bot then return 100, 100 end
    local hum = bot:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function GetBotPos(bot)
    if not bot then return nil end
    local h = bot:FindFirstChild("HumanoidRootPart")
    if h then return h.Position end
    return nil
end

local function GetClosestBot(maxFOV, maxDist)
    maxDist = maxDist or 1000
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    if #BotsCache == 0 then return nil end
    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, bot in ipairs(BotsCache) do
        if bot and bot.Parent then
            local p3 = GetBotPos(bot)
            if p3 then
                local d = (p3 - myPos).Magnitude
                if d <= maxDist then
                    local pos, onS = Camera:WorldToViewportPoint(p3)
                    if onS then
                        local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                        if mag <= maxFOV and mag < bd then
                            local hp = GetBotHP(bot)
                            if hp > 0 then
                                local part = bot:FindFirstChild("Head") or bot:FindFirstChild("HumanoidRootPart")
                                if part then bd = mag; best = part end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

