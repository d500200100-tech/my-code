                    if on1 and on2 then
                        local h = math.abs(tp.Y - bp.Y); local w = h * 0.6
                        local x = tp.X - (w/2); local y = tp.Y
                        
                        if Config.EspBoxes then
                            d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x+w, y)
                            d.box[2].From = Vector2.new(x+w, y); d.box[2].To = Vector2.new(x+w, y+h)
                            d.box[3].From = Vector2.new(x+w, y+h); d.box[3].To = Vector2.new(x, y+h)
                            d.box[4].From = Vector2.new(x, y+h); d.box[4].To = Vector2.new(x, y)
                            for _, l in pairs(d.box) do l.Visible = true end
                        else
                            for _, l in pairs(d.box) do l.Visible = false end
                        end
                        
                        d.text.Visible = (Config.EspNames or Config.EspDist)
                        if d.text.Visible then
                            local name = Config.EspNames and p.Name or ""
                            local distTxt = Config.EspDist and (" [" .. math.floor(dist) .. "m]") or ""
                            d.text.Text = name .. distTxt
                            d.text.Position = Vector2.new(tp.X, y - 16)
                        end

                        if Config.EspHP then
                            local hpPct = hum.Health / hum.MaxHealth
                            d.hpBg.From = Vector2.new(x - 6, y); d.hpBg.To = Vector2.new(x - 6, y + h)
                            d.hpBar.From = Vector2.new(x - 6, y + h - (h * hpPct)); d.hpBar.To = Vector2.new(x - 6, y + h)
                            d.hpBar.Color = Color3.fromHSV(hpPct * 0.3, 1, 1)
                            d.hpBg.Visible = true; d.hpBar.Visible = true
                        else
                            d.hpBg.Visible = false; d.hpBar.Visible = false
                        end

                        if Config.EspTracers then
                            d.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                            d.tracer.To = Vector2.new(tp.X, y + h)
                            d.tracer.Color = COLOR_MAIN
                            d.tracer.Visible = true
                        else
                            d.tracer.Visible = false
                        end
                        isR = true
                    else
                        if Config.Aim and dist <= Config.ArrowDistance then
                            table.insert(offScreenTargets, {pos = head.Position, dist = dist})
                        end
                    end
                end
            end
        end
        if not isR then 
            for _, l in pairs(d.box) do l.Visible = false end
            d.text.Visible = false 
            d.hpBg.Visible = false; d.hpBar.Visible = false
            d.tracer.Visible = false
        end
    end

    -- Стрелочки
    for _, tri in pairs(IndicatorArrows) do tri.Visible = false end
    local offScreenTargets = {}
    local arrowIndex = 1

    if Config.Aim and #offScreenTargets > 0 then
        table.sort(offScreenTargets, function(a, b) return a.dist < b.dist end)
        local maxA = math.min(#offScreenTargets, #IndicatorArrows)
        for i = 1, maxA do
            local td = offScreenTargets[i]
            local tri = IndicatorArrows[arrowIndex]
            local relPos = Camera.CFrame:PointToObjectSpace(td.pos)
            local angle = math.atan2(relPos.X, -relPos.Z)
            local dr = Config.AimRadius
            local al = 10
            local hw = 0.16
            local bX, bY = math.sin(angle), math.cos(angle)
            local pX, pY = math.cos(angle), -math.sin(angle)
            local pTip = Vector2.new(screenCenter.X + bX * (dr + al), screenCenter.Y + bY * (dr + al))
            local blX, blY = bX + pX * hw, bY + pY * hw
            local lL = math.sqrt(blX * blX + blY * blY)
            local pL = Vector2.new(screenCenter.X + (blX / lL) * dr, screenCenter.Y + (blY / lL) * dr)
            local brX, brY = bX - pX * hw, bY - pY * hw
            local lR = math.sqrt(brX * brX + brY * brY)
            local pR = Vector2.new(screenCenter.X + (brX / lR) * dr, screenCenter.Y + (brY / lR) * dr)
            local prox = math.clamp(1 - (td.dist / Config.ArrowDistance), 0, 1)
            tri.Visible = true
            tri.Color = COLOR_DIM:Lerp(COLOR_ACCENT, prox)
            tri.PointA = pTip; tri.PointB = pL; tri.PointC = pR
            arrowIndex = arrowIndex + 1
        end
    end

    -- СКЕЛЕТ
    if Config.SkeletonEsp then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                UpdateSkeleton(p, p.Character, p.Team and LocalPlayer.Team and p.Team == LocalPlayer.Team)
            end
        end
    else
        for _, lines in pairs(SkeletonLines) do
            for _, l in pairs(lines) do l.Visible = false end
        end
    end
end)

