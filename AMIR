-- Быстрая функция создания кликабельных кнопок-тумблеров
local function CreateButton(ConfigKey, OnText, OffText, posY)
    local btn = Instance.new("TextButton", Main)
    btn.Size = UDim2.new(0.88, 0, 0, 26)
    btn.Position = UDim2.new(0.06, 0, 0, posY)
    btn.Font = Enum.Font.SourceSansSemibold
    btn.TextSize = 11
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 6)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(40, 40, 50)

    local function updateVisual()
        btn.Text = Config[ConfigKey] and OnText or OffText
        btn.BackgroundColor3 = Config[ConfigKey] and Color3.fromRGB(40, 20, 70) or Color3.fromRGB(25, 25, 30)
        btn.TextColor3 = Config[ConfigKey] and Color3.fromRGB(200, 150, 255) or Color3.fromRGB(170, 170, 180)
    end

    btn.MouseButton1Click:Connect(function()
        Config[ConfigKey] = not Config[ConfigKey]
        updateVisual()
    end)
    updateVisual()
    return btn
end

