-- ============================================================
-- NEXUS HUB | SQUID GAME X (v1.3 | MOBILE FIX + COLOR ESP)
-- ============================================================

local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")

local Config = {
    EspBoxes = false, EspNames = false, EspDist = false, EspHP = false, EspDistance = 5000,
    NoClip = false, SpeedEnabled = false, SpeedValue = 100,
    GlassESP = false
}

local PlayerESP = {}

local Window = WindUI:CreateWindow({
    Title = "NEXUS | SQUID GAME X",
    Author = "v1.3 | MOBILE",
    Folder = "NexusSquid",
    Theme = "Dark",
    Size = UDim2.fromOffset(400, 400), -- Уменьшил меню под экран телефона
})

Window:SetToggleKey(Enum.KeyCode.RightShift)

local VisualsTab = Window:Tab({ Title = "Visuals (ESP)", Icon = "eye" })
local PlayerTab = Window:Tab({ Title = "Player (Speed/Clip)", Icon = "user" })
local MiscTab = Window:Tab({ Title = "Misc (Glass)", Icon = "settings" })

-- ESP Игроков
VisualsTab:Toggle({ Title = "ESP: Боксы", Value = false, Callback = function(s) Config.EspBoxes = s end })
VisualsTab:Toggle({ Title = "ESP: Ники", Value = false, Callback = function(s) Config.EspNames = s end })
VisualsTab:Toggle({ Title = "ESP: Дистанция", Value = false, Callback = function(s) Config.EspDist = s end })
VisualsTab:Toggle({ Title = "ESP: HP", Value = false, Callback = function(s) Config.EspHP = s end })
VisualsTab:Slider({ Title = "Макс. Дистанция", Value = { Min = 100, Max = 10000, Default = 5000 }, Callback = function(v) Config.EspDistance = v end })

-- Ноуклип и Спидхак
PlayerTab:Toggle({ Title = "NoClip (Сквозь стены)", Value = false, Callback = function(s) Config.NoClip = s end })
PlayerTab:Toggle({ Title = "Спидхак (Вкл/Выкл)", Value = false, Callback = function(s) Config.SpeedEnabled = s end })
PlayerTab:Slider({ Title = "Скорость (Спидхак)", Value = { Min = 16, Max = 300, Default = 100 }, Callback = function(v) Config.SpeedValue = v end })

-- ESP Стекол
MiscTab:Toggle({ Title = "ESP Стекол (Glass)", Value = false, Callback = function(s) 
    Config.GlassESP = s
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and (obj.Name:lower():find("glass") or obj.Name:lower():find("tile")) then
            if s then
                if obj.Name:lower():find("safe") then
                    obj.Color = Color3.fromRGB(0, 255, 0) -- Зеленый
                else
                    obj.Color = Color3.fromRGB(255, 0, 0) -- Красный
                end
                obj.Material = Enum.Material.Neon
            else
                obj.Material = Enum.Material.Glass
                obj.Color = Color3.fromRGB(255, 255, 255)
            end
        end
    end
end })

-- ЛОГИКА (NoClip + Speed + ESP)
RunService.RenderStepped:Connect(function()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    -- Спидхак (Принудительно ставим скорость каждый кадр)
    if Config.SpeedEnabled and hum then
        hum.WalkSpeed = Config.SpeedValue
    elseif hum and not Config.SpeedEnabled then
        hum.WalkSpeed = 16 -- Сброс на стандарт
    end

    -- NoClip
    if Config.NoClip and char then
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    -- Отрисовка ESP
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    local myPos = myHrp.Position
    
    -- Очистка
    for player, _ in pairs(PlayerESP) do
        if not player.Parent or not player.Character then
            for _, l in pairs(PlayerESP[player].box) do l:Remove() end
            PlayerESP[player].text:Remove(); PlayerESP[player].hpBg:Remove(); PlayerESP[player].hpBar:Remove()
            PlayerESP[player] = nil
        end
    end
    
    -- Создание
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not PlayerESP[p] then
            local d = { box = {}, text = Drawing.new("Text"), hpBg = Drawing.new("Line"), hpBar = Drawing.new("Line") }
            for i=1,4 do local l = Drawing.new("Line"); l.Thickness = 1; table.insert(d.box, l) end
            d.text.Size = 13; d.text.Center = true; d.text.Outline = true
            d.hpBg.Thickness = 2; d.hpBg.Color = Color3.fromRGB(0,0,0)
            d.hpBar.Thickness = 2
            PlayerESP[p] = d
        end
    end
    
    -- Отрисовка
    for p, d in pairs(PlayerESP) do
        local isR = false
        if p.Character then
            local pChar = p.Character
            local head, hrp, pHum = pChar:FindFirstChild("Head"), pChar:FindFirstChild("HumanoidRootPart"), pChar:FindFirstChildOfClass("Humanoid")
            if head and hrp and pHum then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= Config.EspDistance then 
                    local tp, on1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    local bp, on2 = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,2,0))
                    if on1 and on2 then
                        -- Цвета: Красный (Игрок), Синий (Охранник), Фиолетовый (Фронтмен)
                        local espColor = Color3.fromRGB(255, 0, 0)
                        local lowerName = p.Name:lower()
                        if lowerName:find("guard") or lowerName:find("soldier") then
                            espColor = Color3.fromRGB(0, 100, 255)
                        elseif lowerName:find("frontman") or lowerName:find("boss") then
                            espColor = Color3.fromRGB(170, 0, 255)
                        end
                        
                        local h = math.abs(tp.Y - bp.Y); local w = h * 0.6
                        local x = tp.X - (w/2); local y = tp.Y
                        
                        if Config.EspBoxes then
                            for _, l in pairs(d.box) do l.Color = espColor end
                            d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x+w, y); d.box[1].Visible = true
                            d.box[2].From = Vector2.new(x+w, y); d.box[2].To = Vector2.new(x+w, y+h); d.box[2].Visible = true
                            d.box[3].From = Vector2.new(x+w, y+h); d.box[3].To = Vector2.new(x, y+h); d.box[3].Visible = true
                            d.box[4].From = Vector2.new(x, y+h); d.box[4].To = Vector2.new(x, y); d.box[4].Visible = true
                        else for _, l in pairs(d.box) do l.Visible = false end end
                        
                        d.text.Visible = (Config.EspNames or Config.EspDist)
                        if d.text.Visible then
                            local name = Config.EspNames and p.Name or ""
                            local distTxt = Config.EspDist and (" [" .. math.floor(dist) .. "m]") or ""
                            d.text.Text = name .. distTxt; d.text.Position = Vector2.new(tp.X, y - 16)
                            d.text.Color = espColor
                        end
                        
                        if Config.EspHP then
                            local hpPct = pHum.Health / pHum.MaxHealth
                            d.hpBg.From = Vector2.new(x - 4, y); d.hpBg.To = Vector2.new(x - 4, y + h); d.hpBg.Visible = true
                            d.hpBar.From = Vector2.new(x - 4, y + h - (h * hpPct)); d.hpBar.To = Vector2.new(x - 4, y + h)
                            d.hpBar.Color = Color3.fromHSV(hpPct * 0.3, 1, 1); d.hpBar.Visible = true
                        else d.hpBg.Visible = false; d.hpBar.Visible = false end
                        isR = true
                    end
                end
            end
        end
        if not isR then 
            for _, l in pairs(d.box) do l.Visible = false end
            d.text.Visible = false; d.hpBg.Visible = false; d.hpBar.Visible = false
        end
    end
end)

WindUI:Notify({ Title = "NEXUS", Content = "Мобильная версия готова!", Duration = 5 })
