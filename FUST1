local CurrentTarget = nil

local function GetHealthData(char)
    if not char then return 100, 100 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function GetClosestTarget(maxFOV, maxDist)
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    
    if CurrentTarget and CurrentTarget.Parent then
        local char = CurrentTarget.Parent
        local hp = GetHealthData(char)
        if hp > 0 and (CurrentTarget.Position - myH.Position).Magnitude <= maxDist then
            return CurrentTarget
        end
    end

    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local h = char:FindFirstChild("HumanoidRootPart")
            local head = char:FindFirstChild("Head")
            if h and head then
                local d = (h.Position - myPos).Magnitude
                if d <= maxDist then
                    local pos, onS = Camera:WorldToViewportPoint(head.Position)
                    if onS then
                        local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                        if mag <= maxFOV and mag < bd then
                            local hp = GetHealthData(char)
                            if hp > 0 then bd = mag; best = head end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Поиск лута
local LootItems = {}
local function RefreshLoot()
    local l = {}
    local names = {"crate", "box", "loot", "bag", "stash", "wood", "stone", "ore", "metal", "руда", "камень", "металл", "дерево", "ящик", "сумка"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local lowerName = obj.Name:lower()
            local isLoot = false
            for _, n in ipairs(names) do
                if string.find(lowerName, n) then isLoot = true break end
            end
            if isLoot then table.insert(l, obj) end
        end
    end
    LootItems = l
end
task.spawn(function() RefreshLoot(); while task.wait(5) do RefreshLoot() end end)

-- X-RAY
local XRayParts = {}
local function ToggleXRay(state)
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name:lower():find("wall") or obj.Name:lower():find("foundation") or obj.Name:lower():find("door")) then
                if obj.Transparency < 0.5 then
                    table.insert(XRayParts, {part = obj, orig = obj.Transparency})
                    obj.Transparency = 0.5
                end
            end
        end
    else
        for _, data in ipairs(XRayParts) do
            if data.part and data.part.Parent then data.part.Transparency = data.orig end
        end
        XRayParts = {}
    end
end

