local LootItems = {}
local function RefreshLoot()
    local l = {}
    local names = {"crate", "box", "loot", "bag", "stash", "wood", "stone", "ore", "metal", "руда", "камень", "металл", "дерево", "ящик", "сумка"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local lowerName = obj.Name:lower()
            local isLoot = false
            for _, n in ipairs(names) do
                if string.find(lowerName, n) then isLoot = true break end
            end
            if isLoot then table.insert(l, obj) end
        end
    end
    LootItems = l
end
task.spawn(function() RefreshLoot(); while task.wait(5) do RefreshLoot() end end)

local XRayParts = {}
local function ToggleXRay(state)
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name:lower():find("wall") or obj.Name:lower():find("foundation") or obj.Name:lower():find("door")) then
                if obj.Transparency < 0.5 then
                    table.insert(XRayParts, {part = obj, orig = obj.Transparency})
                    obj.Transparency = 0.5
                end
            end
        end
    else
        for _, data in ipairs(XRayParts) do
            if data.part and data.part.Parent then data.part.Transparency = data.orig end
        end
        XRayParts = {}
    end
end

