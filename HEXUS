-- СКАНИРОВАНИЕ WORSPACE
local function GetRaspadCharacters()
local list = {}
local children = workspace:GetChildren()
for i = 1, #children do
local obj = children[i]
if obj:IsA("Model") and obj.Name ~= LocalPlayer.Name and (obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("LowerTorso") or obj:FindFirstChild("UpperTorso")) then
list[#list + 1] = obj
end
end
return list
end
local function GetTargetParts(model)
local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("LowerTorso") or model:FindFirstChild("UpperTorso")
return root, model:FindFirstChild("Head")
end
local function GetHealthData(model)
if model:GetAttribute("Health") then return model:GetAttribute("Health"), model:GetAttribute("MaxHealth") or 100 end
if model:FindFirstChild("Health") and model.Health:IsA("ValueBase") then return model.Health.Value, 100 end
local hum = model:FindFirstChildOfClass("Humanoid")
if hum then return hum.Health, hum.MaxHealth end
return 100, 100
end
