local function GetPlayerCharacter(player)
    if not player then return nil end
    local char = player.Character or workspace:FindFirstChild(player.Name)
    if not char and workspace:FindFirstChild("Players") then
        char = workspace.Players:FindFirstChild(player.Name)
    end
    return char
end

local function GetStableCFrame(char)
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("UpperTorso") or char.PrimaryPart
    if root then return root.CFrame end
    return nil
end

local function GetHealthData(char)
    if not char then return 100, 100 end
    if char:GetAttribute("Health") then return char:GetAttribute("Health"), char:GetAttribute("MaxHealth") or 100 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function isVisible(targetPart)
    if not Config.WallCheck then return true end
    local char = LocalPlayer.Character
    if not char or not targetPart then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char, targetPart.Parent}
    local ray = workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, params)
    return ray == nil
end

local function GetClosestTargetPart(maxFOV, maxDistance)
    maxDistance = maxDistance or Config.EspDistance
    local myChar = LocalPlayer.Character
    local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("LowerTorso"))
    if not myHrp then return nil end
    
    local closest, shortestDist = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local players = Players:GetPlayers()
    
    for i = 1, #players do
        local p = players[i]
        if p and p ~= LocalPlayer then
            if Config.TeamCheck and p.Team == LocalPlayer.Team then continue end
            local char = GetPlayerCharacter(p)
            local cf = GetStableCFrame(char)
            local curHp, _ = GetHealthData(char)
            
            if cf and curHp > 0 then
                local dist = (cf.Position - myHrp.Position).Magnitude
                if dist <= maxDistance then
                    local pos, onScreen = Camera:WorldToViewportPoint(cf.Position)
                    if onScreen then
                        local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                        if mag <= maxFOV and mag < shortestDist then
                            local aimPartObj = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                            if aimPartObj and isVisible(aimPartObj) then
                                shortestDist = mag
                                closest = aimPartObj
                            end
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function IsValidTarget(part, maxFOV, maxDistance)
    if not part or not part.Parent or not part:IsDescendantOf(workspace) then return false end
    local char = part.Parent
    local curHp, _ = GetHealthData(char)
    if curHp <= 0 then return false end
    if not isVisible(part) then return false end
    local myChar = LocalPlayer.Character
    local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("LowerTorso"))
    if not myHrp then return false end
    if (part.Position - myHrp.Position).Magnitude > maxDistance then return false end
    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
    if not onScreen then return false end
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if (Vector2.new(pos.X, pos.Y) - center).Magnitude > maxFOV then return false end
    return true
end

