RunService.RenderStepped:Connect(function()
local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
if AimCircle.Visible then AimCircle.Position = screenCenter AimCircle.Radius = Config.AimRadius end
if Config.Aim then
if CurrentAimTarget and IsValidTarget(CurrentAimTarget, Config.AimRadius, Config.AimDistance) then
Camera.CFrame = CFrame.new(Camera.CFrame.Position, CurrentAimTarget.Position)
else
CurrentAimTarget = GetClosestTargetPart(Config.AimRadius, Config.AimDistance)
if CurrentAimTarget then Camera.CFrame = CFrame.new(Camera.CFrame.Position, CurrentAimTarget.Position) end
end
else
CurrentAimTarget = nil
end
for _, tri in pairs(IndicatorArrows) do tri.Visible = false end
local offScreenTargets = {}
local arrowIndex = 1
for p, d in pairs(EspObjects) do
local char = p and GetPlayerCharacter(p)
local isRendered = false
local rootPart = char and char:FindFirstChild("HumanoidRootPart")
local myChar = LocalPlayer.Character
local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("LowerTorso"))
if myHrp and p.Character then
local targetPos = rootPart and rootPart.Position or p.Character:GetPivot().Position
local realDist = (targetPos - myHrp.Position).Magnitude
if realDist <= Config.EspDistance then
local pos2D, onScreen = Camera:WorldToViewportPoint(targetPos)
if onScreen then
local size = char and char:GetExtentsSize() or Vector3.new(4, 5, 2)
local pivot = char and char:GetPivot() or CFrame.new(targetPos)
local topPos, topOnScreen = Camera:WorldToViewportPoint(pivot.Position + Vector3.new(0, (size.Y / 2) + 0.3, 0))
local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(pivot.Position - Vector3.new(0, (size.Y / 2), 0))
if topOnScreen and bottomOnScreen then
local boxHeight = math.abs(topPos.Y - bottomPos.Y)
local boxWidth = boxHeight * 0.6
local x = topPos.X - (boxWidth / 2)
local y = topPos.Y
local dynamicColor = VisualColor
local curHp, maxHp = GetHealthData(char)
if Config.EspBoxes then
if not d.highlight or d.highlight.Parent ~= char then
pcall(function() if d.highlight then d.highlight:Destroy() end end)
if char then
d.highlight = Instance.new("Highlight")
d.highlight.Parent = char
end
end
if d.highlight then
d.highlight.Enabled = true
d.highlight.FillTransparency = 1
d.highlight.OutlineTransparency = 0
d.highlight.OutlineColor = dynamicColor
d.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end
-- ИСПРАВЛЕНО: Четвертая сторона бокса теперь рисуется ровно, а не по диагонали экрана
for idx, l in pairs(d.box) do
l.Visible = true
l.Color = dynamicColor
if idx == 1 then l.From, l.To = Vector2.new(x, y), Vector2.new(x + boxWidth, y)
elseif idx == 2 then l.From, l.To = Vector2.new(x + boxWidth, y), Vector2.new(x + boxWidth, y + boxHeight)
elseif idx == 3 then l.From, l.To = Vector2.new(x + boxWidth, y + boxHeight), Vector2.new(x, y + boxHeight)
elseif idx == 4 then l.From, l.To = Vector2.new(x, y + boxHeight), Vector2.new(x, y) end
end
else
if d.highlight then d.highlight.Enabled = false end
for _, l in pairs(d.box) do l.Visible = false end
end
d.tracer.Visible = Config.EspTracers
if Config.EspTracers then
d.tracer.Color = dynamicColor
d.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
d.tracer.To = Vector2.new(topPos.X, bottomPos.Y)
end
d.text.Visible = (Config.EspNames or Config.EspDist)
if d.text.Visible then
d.text.Color = WhiteColor
d.text.Text = (Config.EspNames and (p.DisplayName or p.Name) or "") .. (Config.EspDist and " [" .. math.floor(realDist) .. "м]" or "")
d.text.Position = Vector2.new(topPos.X, y - 16)
end
d.hpBg.Visible = Config.EspHP
d.hpBar.Visible = Config.EspHP
if Config.EspHP then
local hp_val = math.clamp(curHp / maxHp, 0, 1)
d.hpBg.From = Vector2.new(x - 5, y + boxHeight)
d.hpBg.To = Vector2.new(x - 5, y)
d.hpBar.From = Vector2.new(x - 5, y + boxHeight)
d.hpBar.To = Vector2.new(x - 5, y + boxHeight - (boxHeight * hp_val))
d.hpBar.Color = Color3.fromHSV(hp_val * 0.3, 1, 1)
end
isRendered = true
end
else
if Config.Aim and realDist <= Config.ArrowDistance then
table.insert(offScreenTargets, {pos = targetPos, dist = realDist})
end
end
end
end
if not isRendered then
if d.highlight then d.highlight.Enabled = false end
for _, l in pairs(d.box) do l.Visible = false end
d.tracer.Visible = false
d.text.Visible = false
d.hpBg.Visible = false
d.hpBar.Visible = false
end
end
-- СТРЕЛОЧКИ НА КРУГЕ FOV (Градиент от серого к белому в зависимости от расстояния до цели)
if Config.Aim and #offScreenTargets > 0 then
table.sort(offScreenTargets, function(a, b) return a.dist < b.dist end)
for i = 1, math.min(#offScreenTargets, #IndicatorArrows) do
local targetData = offScreenTargets[i]
local tri = IndicatorArrows[arrowIndex]
local camCFrame = Camera.CFrame
local relativePos = camCFrame:PointToObjectSpace(targetData.pos)
local angle = math.atan2(relativePos.X, -relativePos.Z)
local drawRadius = Config.AimRadius
local pTip = screenCenter + Vector2.new(math.sin(angle), math.cos(angle)) * drawRadius
local pLeft = screenCenter + Vector2.new(math.sin(angle - 0.18), math.cos(angle - 0.18)) * (drawRadius - 22)
local pRight = screenCenter + Vector2.new(math.sin(angle + 0.18), math.cos(angle + 0.18)) * (drawRadius - 22)
local arrowColor = Color3.fromRGB(130, 130, 135):Lerp(WhiteColor, math.clamp(1 - (targetData.dist / Config.ArrowDistance), 0, 1))
tri.Visible = true
tri.Color = arrowColor
tri.PointA = pTip
tri.PointB = pLeft
tri.PointC = pRight
arrowIndex = arrowIndex + 1
end
end
end)
