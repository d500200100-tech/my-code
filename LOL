-- СЕТЕВЫЕ МЕТАХУКИ (МУЛЬТИХИТ ВАНШОТ)
local gHook
gHook = hookmetamethod(game, "__namecall", function(self, ...)
local args = {...}
local method = getnamecallmethod()
if method == "FireServer" and Config.AntiHitscan then
if self.Name:lower():find("damage") or self.Name:lower():find("hit") then
if args == LocalPlayer or args == LocalPlayer or args == LocalPlayer.Character then return nil end
end
end
if method == "FireServer" or method == "InvokeServer" then
local nameLower = self.Name:lower()
if Config.NoRecoil and (nameLower:find("recoil") or nameLower:find("sway") or nameLower:find("shake") or nameLower:find("kick")) then return nil end
if nameLower:find("shoot") or nameLower:find("hit") or nameLower:find("bullet") or nameLower:find("fire") or nameLower:find("damage") then
if Config.OneShot then
local target = CurrentAimTarget or GetClosestTargetPart(Config.AimRadius, Config.AimDistance)
if target then
local mockArgs = {}
for idx, val in ipairs(args) do
if typeof(val) == "Vector3" then mockArgs[idx] = target.Position
elseif typeof(val) == "Instance" and val:IsA("BasePart") then mockArgs[idx] = target
else mockArgs[idx] = val end
end
for i = 1, 15 do gHook(self, unpack(mockArgs)) end
return gHook(self, unpack(mockArgs))
end
end
end
end
return gHook(self, ...)
end)
local indexHook
indexHook = hookmetamethod(game, "__index", function(self, key)
if Config.NoRecoil and (key == "Recoil" or key == "RecoilControl" or key == "Sway" or key == "Kick" or key == "Shake" or key == "Spread") then return 0 end
return indexHook(self, key)
end)
