    Size = UDim2.fromOffset(350, 400),
})

Window:SetToggleKey(Enum.KeyCode.RightShift)

-- ФУНКЦИЯ ЗАГРУЗКИ
local function LoadScript(url, name)
    WindUI:Notify({ Title = "Загрузка", Content = "Загружаем " .. name .. "...", Duration = 2 })
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if not success then
        WindUI:Notify({ Title = "Ошибка", Content = "Не удалось загрузить скрипт.", Duration = 5 })
    end
end

