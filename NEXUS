local DrawingESP = {}
local function CreateDrawingESP()
local esp = { Line = Drawing.new("Line") }
esp.Line.Color = CurrentRGB
esp.Line.Thickness = 1
return esp
end
local function HideDrawing(esp)
if esp then esp.Line.Visible = false end
end
local function DestroyDrawing(esp)
if esp then esp.Line:Remove() end
end
-- ОБХОД ЗАЩИТЫ РАСПАДА
local function GetBreakdownPlayers()
local targets = {}
pcall(function()
for _, obj in ipairs(workspace:GetChildren()) do
if obj and obj:IsA("Model") and obj.Name ~= LocalPlayer.Name and game.Players:FindFirstChild(obj.Name) then
local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("LowerTorso")
if hrp then table.insert(targets, obj) end
end
end
end)
return targets
end
local function GetTargetParts(model)
local root = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("LowerTorso") or model:FindFirstChild("UpperTorso")
return root, model:FindFirstChild("Head")
end
local function GetHealthData(model)
if model:GetAttribute("Health") then return model:GetAttribute("Health"), model:GetAttribute("MaxHealth") or 100 end
if model:FindFirstChild("Health") and model.Health:IsA("ValueBase") then return model.Health.Value, 100 end
local hum = model:FindFirstChildOfClass("Humanoid")
if hum then return hum.Health, hum.MaxHealth end
return 100, 100
end
local function IsVisible(part, character)
if not Config.WallCheck then return true end
if not part or not character then return false end
local castPoints = {Camera.CFrame.Position, part.Position}
local ignoreList = {LocalPlayer.Character, character, Camera}
local ray = Ray.new(castPoints, (castPoints - castPoints).Unit * (castPoints - castPoints).Magnitude)
local hit, _ = workspace:FindPartOnRayWithIgnoreList(ray, ignoreList)
return hit == nil
end
-- ПОТОК АИМБОТА И TRIGGERBOT
game:GetService("RunService").Heartbeat:Connect(function()
FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
FOVCircle.Radius = Config.FOV
FOVCircle.Visible = (Config.AimBot or Config.Silent)
local myChar = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("LowerTorso"))
if not myHrp then return end
local closest, shortestDist = nil, math.huge
local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
local targets = GetBreakdownPlayers()
for _, model in ipairs(targets) do
local root, head = GetTargetParts(model)
local curHp, _ = GetHealthData(model)
if root and curHp > 0 then
if head and Config.Hitbox then
head.Size = Vector3.new(5, 5, 5)
head.CanCollide = false; head.Transparency = 0.5
else
head.Size = Vector3.new(1.2, 1.2, 1.2); head.Transparency = 0
end
local dist = (head.Position - myHrp.Position).Magnitude
if dist <= Config.Distance and IsVisible(head, model) then
local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
if onScreen then
local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
if mag <= Config.FOV and mag < shortestDist then
shortestDist = mag; closest = head
end
end
end
end
end
if Config.AimBot and closest then
Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closest.Position), Config.AimSmoothing)
end
if Config.TriggerBot and closest then
local mousePos = game:GetService("UserInputService"):GetMouseLocation()
local viewPos, _ = Camera:WorldToViewportPoint(closest.Position)
if (Vector2.new(viewPos.X, viewPos.Y) - mousePos).Magnitude <= 25 then
pcall(function()
local virtualUser = game:GetService("VirtualUser")
virtualUser:CaptureController()
virtualUser:ClickButton1(Vector2.new(0,0))
end)
end
end
end)
