if myChar then
local stats = myChar:FindFirstChild("Stats") or myChar:FindFirstChild("Values")
local stamina = myChar:FindFirstChild("Stamina") or (stats and stats:FindFirstChild("Stamina"))
if Config.InfStamina and stamina then stamina.Value = 100 end
end
local currentTargets = GetBreakdownPlayers()
local guiInset = game:GetService("GuiService"):GetGuiInset()
local yOffsetFix = guiInset.Y
if not Config.Tracers then
for model, esp in pairs(DrawingESP) do HideDrawing(esp) end
else
local activeModelsThisFrame = {}
for i = 1, #currentTargets do
local model = currentTargets[i]
local root, head = GetTargetParts(model)
local curHp, _ = GetHealthData(model)
if root and curHp > 0 and myHrp then
local dist = (root.Position - myHrp.Position).Magnitude
if dist <= Config.Distance then
local rootScreenPos, onScreen = Camera:WorldToScreenPoint(root.Position)
if onScreen then
activeModelsThisFrame[model] = true
if not DrawingESP[model] then DrawingESP[model] = CreateDrawingESP() end
local esp = DrawingESP[model]
local headScreenPos = head and Camera:WorldToScreenPoint(head.Position) or rootScreenPos
local boxHeight = math.abs(headScreenPos.Y - rootScreenPos.Y) * 2
local correctedRootY = rootScreenPos.Y + yOffsetFix
-- Рисуем только чистые линии к торсу
esp.Line.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
esp.Line.To = Vector2.new(rootScreenPos.X, correctedRootY + (boxHeight / 4))
esp.Line.Color = CurrentRGB
esp.Line.Visible = true
end
end
end
end
for model, esp in pairs(DrawingESP) do
if not activeModelsThisFrame[model] then
DestroyDrawing(esp)
DrawingESP[model] = nil
end
end
end
end)
