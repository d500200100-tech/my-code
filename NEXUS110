local function CreateSlider(Page, Text, ConfigKey, Min, Max, PosY, IsDist)
    local Frame = Instance.new("Frame", Pages[Page])
    Frame.Size = UDim2.new(1, -5, 0, 42)
    Frame.Position = UDim2.new(0, 0, 0, PosY)
    Frame.BackgroundTransparency = 1

    local Label = Instance.new("TextLabel", Frame)
    Label.Size = UDim2.new(1, 0, 0, 18)
    Label.Text = "  " .. Text .. ": " .. Config[ConfigKey] .. (IsDist and "m" or "")
    Label.TextColor3 = Color3.fromRGB(180, 175, 200)
    Label.TextSize = 12
    Label.Font = Enum.Font.SourceSans
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.BackgroundTransparency = 1

    local Bar = Instance.new("TextButton", Frame)
    Bar.Size = UDim2.new(1, -10, 0, 6)
    Bar.Position = UDim2.new(0, 5, 0, 24)
    Bar.BackgroundColor3 = Color3.fromRGB(30, 26, 38)
    Bar.Text = ""
    Instance.new("UICorner", Bar).CornerRadius = UDim.new(0, 3)

    local Fill = Instance.new("Frame", Bar)
    Fill.Size = UDim2.new((Config[ConfigKey] - Min) / (Max - Min), 0, 1, 0)
    Fill.BackgroundColor3 = Color3.fromRGB(150, 70, 255)
    Instance.new("UICorner", Fill).CornerRadius = UDim.new(0, 3)

    local Dragging = false
    local function Update(input)
        local ratio = math.clamp((input.Position.X - Bar.AbsolutePosition.X) / Bar.AbsoluteSize.X, 0, 1)
        local val = Min + ratio * (Max - Min)
        if Min >= 1 then val = math.floor(val) else val = tonumber(string.format("%.2f", val)) end
        Config[ConfigKey] = val
        Label.Text = "  " .. Text .. ": " .. val .. (IsDist and "m" or "")
        Fill.Size = UDim2.new(ratio, 0, 1, 0)
    end

    Bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Dragging = true Update(input) end
    end)
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then Update(input) end
    end)
    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then Dragging = false end
    end)
end

