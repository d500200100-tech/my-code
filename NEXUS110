local function HideDrawing(esp)
if esp then
esp.Box.Visible = false
esp.Text.Visible = false
esp.HealthBg.Visible = false
esp.HealthBar.Visible = false
esp.Line.Visible = false
end
end
local function DestroyDrawing(esp)
if esp then
esp.Box:Remove()
esp.Text:Remove()
esp.HealthBg:Remove()
esp.HealthBar:Remove()
esp.Line:Remove()
end
end
-- УЛЬТРА-СКОРОСТНОЙ ПОИСК: Вытягиваем данные напрямую из Players
local function GetPlayerCharacter(player)
if not player then return nil end
local char = player.Character or workspace:FindFirstChild(player.Name)
if not char and workspace:FindFirstChild("Players") then
char = workspace.Players:FindFirstChild(player.Name)
end
return char
end
local function GetStableCFrame(char)
if not char then return nil end
local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("LowerTorso") or char:FindFirstChild("UpperTorso") or char.PrimaryPart
if root then return root.CFrame end
return nil
end
local function GetHealthData(char)
if not char then return 100, 100 end
if char:GetAttribute("Health") then return char:GetAttribute("Health"), char:GetAttribute("MaxHealth") or 100 end
if char:FindFirstChild("Health") and char.Health:IsA("ValueBase") then return char.Health.Value, 100 end
local hum = char:FindFirstChildOfClass("Humanoid")
if hum then return hum.Health, hum.MaxHealth end
return 100, 100
end
-- ФУНКЦИЯ ДЛЯ НАХОЖДЕНИЯ САМОЙ БЛИЗКОЙ ЦЕЛИ К КУРСОРУ (Для Аима и Сайлента)
local function GetClosestTargetPart()
local myChar = LocalPlayer.Character or workspace:FindFirstChild(LocalPlayer.Name)
local myHrp = myChar and (myChar:FindFirstChild("HumanoidRootPart") or myChar:FindFirstChild("LowerTorso"))
if not myHrp then return nil end
local closest, shortestDist = nil, math.huge
local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
local players = game:GetService("Players"):GetPlayers()
for i = 1, #players do
local p = players[i]
if p and p ~= LocalPlayer then
if Config.TeamCheck and p.Team == LocalPlayer.Team then continue end
local char = GetPlayerCharacter(p)
local cf = GetStableCFrame(char)
local curHp, _ = GetHealthData(char)
if cf and curHp > 0 then
local dist = (cf.Position - myHrp.Position).Magnitude
if dist <= Config.Distance then
local pos, onScreen = Camera:WorldToViewportPoint(cf.Position)
if onScreen then
local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
if mag <= Config.FOV and mag < shortestDist then
shortestDist = mag
closest = char:FindFirstChild(Config.AimPart) or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("LowerTorso")
end
end
end
end
end
end
return closest
end
