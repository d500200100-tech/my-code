-- НЕВИДИМОСТЬ
local function ApplyInvis(char)
    if not char then return end
    for _, n in ipairs(BODY_PARTS) do
        local p = char:FindFirstChild(n)
        if p and p:IsA("BasePart") then
            local t = 0
            if Config.InvisMode == "Full" then t = 1
            elseif Config.InvisMode == "Ghost" then t = 0.9 end
            if p.Transparency ~= t then
                p.Transparency = t
                p.LocalTransparencyModifier = t
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.3) do
        if Config.Invisible then ApplyInvis(LocalPlayer.Character) end
    end
end)

