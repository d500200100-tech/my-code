local function GetHealthData(char)
    if not char then return 100, 100 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function isVisible(part)
    if not Config.WallCheck then return true end
    local char = LocalPlayer.Character
    if not char or not part then return false end
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = {char, part.Parent}
    local ray = workspace:Raycast(Camera.CFrame.Position, part.Position - Camera.CFrame.Position, p)
    return ray == nil
end

local function GetAimPart(char)
    if not char then return nil end
    local m = Config.AimTargetPart
    if m == "Head" then return char:FindFirstChild("Head")
    elseif m == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    elseif m == "HumanoidRootPart" then return char:FindFirstChild("HumanoidRootPart")
    else return char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head") end
end

-- ИСПРАВЛЕННЫЙ ПОИСК БОТОВ (Ищем по всему workspace и потомкам)
local BotsCache = {}
local function IsPlayerChar(m) return Players:GetPlayerFromCharacter(m) ~= nil end
local function RefreshBots()
    local l = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and not IsPlayerChar(o) then
            local hum = o:FindFirstChildOfClass("Humanoid")
            if hum and (o:FindFirstChild("HumanoidRootPart") or o:FindFirstChild("Head")) then
                table.insert(l, o)
            end
        end
    end
    BotsCache = l
end
task.spawn(function()
    RefreshBots()
    while task.wait(3) do RefreshBots() end
end)

local function GetBotHP(bot)
    if not bot then return 100, 100 end
    local hum = bot:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function GetBotPart(bot)
    if not bot then return nil end
    local m = Config.BotAimTargetPart
    if m == "Head" then return bot:FindFirstChild("Head")
    elseif m == "Torso" then return bot:FindFirstChild("UpperTorso") or bot:FindFirstChild("Torso")
    elseif m == "HumanoidRootPart" then return bot:FindFirstChild("HumanoidRootPart")
    else return bot:FindFirstChild("UpperTorso") or bot:FindFirstChild("HumanoidRootPart") or bot:FindFirstChild("Head") end
end

local function GetBotPos(bot)
    if not bot then return nil end
    local h = bot:FindFirstChild("HumanoidRootPart")
    if h then return h.Position end
    return nil
end

local function GetClosestTarget(maxFOV, maxDist)
    maxDist = maxDist or Config.EspDistance
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not (Config.TeamCheck and p.Team == LocalPlayer.Team) then
            local char = p.Character
            if char then
                local h = char:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - myPos).Magnitude
                    if d <= maxDist then
                        local pos, onS = Camera:WorldToViewportPoint(h.Position)
                        if onS then
                            local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                            if mag <= maxFOV and mag < bd then
                                local hp = GetHealthData(char)
                                if hp > 0 then
                                    local ap = GetAimPart(char)
                                    if ap and isVisible(ap) then bd = mag; best = ap end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function GetClosestBot(maxFOV, maxDist)
    maxDist = maxDist or Config.BotEspDistance
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    if #BotsCache == 0 then return nil end
    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, bot in ipairs(BotsCache) do
        if bot and bot.Parent then
            local p3 = GetBotPos(bot)
            if p3 then
                local d = (p3 - myPos).Magnitude
                if d <= maxDist then
                    local pos, onS = Camera:WorldToViewportPoint(p3)
                    if onS then
                        local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                        if mag <= maxFOV and mag < bd then
                            local hp = GetBotHP(bot)
                            if hp > 0 then
                                local part = GetBotPart(bot)
                                if part then bd = mag; best = part end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local function SA_GetTarget()
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not (Config.TeamCheck and p.Team == LocalPlayer.Team) then
            local char = p.Character
            if char then
                local h = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if h and hum and hum.Health > 0 then
                    local d = (h.Position - myPos).Magnitude
                    if d <= Config.SA_MaxDist then
                        local part
                        if Config.SA_TargetPart == "Head" then part = char:FindFirstChild("Head")
                        elseif Config.SA_TargetPart == "Torso" then part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
                        else part = h end
                        if part then
                            local pos, onS = Camera:WorldToViewportPoint(part.Position)
                            if onS then
                                local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                                if mag <= Config.SA_FOV and mag < bd then
                                    bd = mag; best = part
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- SKELETON
local SKELETON_LINKS = {
    {"Head","UpperTorso"},{"UpperTorso","LowerTorso"},
    {"UpperTorso","RightUpperArm"},{"RightUpperArm","RightLowerArm"},{"RightLowerArm","RightHand"},
    {"UpperTorso","LeftUpperArm"},{"LeftUpperArm","LeftLowerArm"},{"LeftLowerArm","LeftHand"},
    {"LowerTorso","RightUpperLeg"},{"RightUpperLeg","RightLowerLeg"},{"RightLowerLeg","RightFoot"},
    {"LowerTorso","LeftUpperLeg"},{"LeftUpperLeg","LeftLowerLeg"},{"LeftLowerLeg","LeftFoot"},
}
local SKELETON_R6 = {
    {"Head","Torso"},{"Torso","Right Arm"},{"Right Arm","RightHand"},
    {"Torso","Left Arm"},{"Left Arm","LeftHand"},
    {"Torso","Right Leg"},{"Right Leg","RightFoot"},
    {"Torso","Left Leg"},{"Left Leg","LeftFoot"},
}

local SkeletonLines = {}
local function CreateSkeleton(player)
    if SkeletonLines[player] then return end
    local lines = {}
    for i = 1, #SKELETON_LINKS do
        local l = Drawing.new("Line")
        l.Thickness = Config.SkeletonThickness; l.Color = COLOR_SKEL; l.Visible = false
        table.insert(lines, l)
    end
    SkeletonLines[player] = lines
end

local function RemoveSkeleton(player)
    if SkeletonLines[player] then
        for _, l in ipairs(SkeletonLines[player]) do l:Remove() end
        SkeletonLines[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreateSkeleton(p) end
end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then CreateSkeleton(p) end end)
Players.PlayerRemoving:Connect(function(p) RemoveSkeleton(p) end)

local function UpdateSkeleton(player, char, isTeam)
    local lines = SkeletonLines[player]
    if not lines then return end
    local links = SKELETON_LINKS
    if not char:FindFirstChild("UpperTorso") and char:FindFirstChild("Torso") then
        links = SKELETON_R6
    end
    local color
    if Config.SkeletonColorMode == "Team" then
        color = isTeam and COLOR_TEAM or COLOR_MAIN
    elseif Config.SkeletonColorMode == "Rainbow" then
        color = Color3.fromHSV((tick() * 0.5) % 1, 0.8, 1)
    else
        color = COLOR_SKEL
    end
    for i, link in ipairs(links) do
        local l = lines[i]
        if not l then break end
        local p1 = char:FindFirstChild(link[1])
        local p2 = char:FindFirstChild(link[2])
        if p1 and p2 then
            local v1, on1 = Camera:WorldToViewportPoint(p1.Position)
            local v2, on2 = Camera:WorldToViewportPoint(p2.Position)
            if on1 and on2 then
                l.From = Vector2.new(v1.X, v1.Y)
                l.To = Vector2.new(v2.X, v2.Y)
                l.Color = color; l.Thickness = Config.SkeletonThickness; l.Visible = true
            else l.Visible = false end
        else l.Visible = false end
    end
    for i = #links + 1, #lines do lines[i].Visible = false end
end

-- LAST HIT
local lastHP = 100
local lastHitTime = 0
local lastHitPos = nil

task.spawn(function()
    while task.wait(0.15) do
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.Health < lastHP then
                lastHitTime = tick()
                local myH = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if myH then
                    local closest, cd = nil, math.huge
                    for _, p in ipairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer then
                            local h = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                            if h then
                                local d = (h.Position - myH.Position).Magnitude
                                if d < cd then cd = d; closest = h.Position end
                            end
                        end
                    end
                    lastHitPos = closest
                end
            end
            lastHP = hum.Health
        end
    end
end)

