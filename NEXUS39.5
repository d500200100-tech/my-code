local PlayerEsp = {}
local function CreatePlayerEsp(player)
    if PlayerEsp[player] then return end
    local d = {
        highlight = nil,
        box = {Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line")},
        tracer = Drawing.new("Line"),
        text = Drawing.new("Text"),
        hpBg = Drawing.new("Line"),
        hpBar = Drawing.new("Line")
    }
    for _, l in pairs(d.box) do l.Thickness = 1.5; l.Color = COLOR_MAIN end
    d.tracer.Thickness = 1.5; d.tracer.Color = COLOR_MAIN
    d.hpBg.Thickness = 2.5; d.hpBg.Color = Color3.fromRGB(20, 20, 20)
    d.hpBar.Thickness = 1.5
    d.text.Size = 13; d.text.Center = true; d.text.Outline = true; d.text.Color = COLOR_ACCENT
    PlayerEsp[player] = d
end

local function RemovePlayerEsp(player)
    if PlayerEsp[player] then
        local d = PlayerEsp[player]
        if d.highlight then pcall(function() d.highlight:Destroy() end) end
        for _, l in pairs(d.box) do l:Remove() end
        d.tracer:Remove(); d.text:Remove(); d.hpBg:Remove(); d.hpBar:Remove()
        PlayerEsp[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then CreatePlayerEsp(p) end
end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then CreatePlayerEsp(p) end end)
Players.PlayerRemoving:Connect(function(p) RemovePlayerEsp(p) end)

