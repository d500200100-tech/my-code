-- ХИТБОКСЫ
local OrigSizes = {}
local function SaveSize(p)
    if not OrigSizes[p] then
        OrigSizes[p] = {Size = p.Size, Transparency = p.Transparency,
            Color = p.Color, Material = p.Material,
            CanCollide = p.CanCollide, Massless = p.Massless}
    end
end
local function RestoreSize(p)
    if OrigSizes[p] and p and p.Parent then
        local o = OrigSizes[p]
        pcall(function()
            p.Size = o.Size; p.Transparency = o.Transparency
            p.Color = o.Color; p.Material = o.Material
            p.CanCollide = o.CanCollide; p.Massless = o.Massless
        end)
    end
end

task.spawn(function()
    while task.wait(0.5) do
        local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myH then
            local myPos = myH.Position
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer then
                    local char = p.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        local head = char:FindFirstChild("Head")
