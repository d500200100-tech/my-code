-- СТАРЫЙ ХУК
-- ============================================================
local gHook
gHook = hookmetamethod(game, "__namecall", function(self, ...)
    local args = {...}
    local method = getnamecallmethod()
    local nL = tostring(self.Name):lower()

    if method == "FireServer" and Config.AntiHitscan then
        if nL:find("damage") or nL:find("hit") then
            if args[1] == LocalPlayer or args[1] == LocalPlayer.Character then return nil end
        end
    end

    if method == "FireServer" or method == "InvokeServer" then
        if Config.NoRecoil and (nL:find("recoil") or nL:find("sway")
            or nL:find("shake") or nL:find("kick")) then return nil end
        if Config.OneShot and (nL:find("shoot") or nL:find("hit")
            or nL:find("bullet") or nL:find("fire") or nL:find("damage")) then
            local target = CurrentBotAimTarget or CurrentAimTarget
                or GetClosestBot(Config.BotAimRadius, Config.BotAimDistance)
                or GetClosestTarget(Config.AimRadius, Config.AimDistance)
            if target then
                local mock = {}
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then mock[i] = target.Position
                    elseif typeof(v) == "Instance" and v:IsA("BasePart") then mock[i] = target
                    else mock[i] = v end
                end
                for i = 1, 15 do gHook(self, unpack(mock)) end
                return gHook(self, unpack(mock))
            end
        end
    end
    return gHook(self, ...)
end)

-- ============================================================
-- SILENT AIM HOOK
-- ============================================================
local saMeta = getrawmetatable(game)
local saOldIndex = saMeta.__index
local saOldNamecall = saMeta.__namecall
setreadonly(saMeta, false)

saMeta.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if Config.SA_Enabled and math.random(1, 100) <= Config.SA_HitChance then
        local target = SA_GetTarget()
        if target then
            if Config.SA_M1_Raycast and method == "Raycast" and self == workspace then
                if typeof(args[2]) == "Vector3" then
                    local origin = args[1]
                    local oldDir = args[2]
                    args[2] = (target.Position - origin).Unit * oldDir.Magnitude
                end
                return saOldNamecall(self, unpack(args))
            end

            if Config.SA_M2_FindPartOnRay and method == "FindPartOnRay" and self == workspace then
                if typeof(args[1]) == "Ray" then
                    local ray = args[1]
                    local newDir = (target.Position - ray.Origin).Unit * ray.Direction.Magnitude
                    args[1] = Ray.new(ray.Origin, newDir)
                end
                return saOldNamecall(self, unpack(args))
            end

            if Config.SA_M4_FireServer and (method == "FireServer" or method == "InvokeServer") then
                local hasVec = false
                for i, v in ipairs(args) do
                    if typeof(v) == "Vector3" then
                        hasVec = true
                        args[i] = target.Position
                    end
                end
                if hasVec then
                    return saOldNamecall(self, unpack(args))
                end
            end
        end
    end

    return saOldNamecall(self, ...)
end)

saMeta.__index = newcclosure(function(self, key)
    if Config.SA_Enabled and Config.SA_M3_Mouse and tostring(self) == "Mouse" then
        if key == "Hit" or key == "Target" then
            if math.random(1, 100) <= Config.SA_HitChance then
                local target = SA_GetTarget()
                if target then
                    if key == "Hit" then return CFrame.new(target.Position) end
                    if key == "Target" then return target end
                end
            end
        end
    end
    return saOldIndex(self, key)
end)

setreadonly(saMeta, true)

