                                head.Transparency = Config.HitboxTransparency
                                head.CanCollide = false
                                head.Massless = true
                            end
                        else
                            if hrp then RestoreSize(hrp) end
                            if head then RestoreSize(head) end
                        end
                    end
                end
            end
        end
    end
end)

