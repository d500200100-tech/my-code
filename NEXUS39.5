                if lines then for _, l in pairs(lines) do l.Visible = false end end
            end

            if myHrp and char then
                local head = char:FindFirstChild("Head")
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                local targetPos = hrp and hrp.Position or char:GetPivot().Position
                local realDist = (targetPos - myPos).Magnitude

                if realDist <= Config.EspDistance then
                    local topWorld, bottomWorld
                    if head and hrp then
                        topWorld = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
                        local hipHeight = (hum and hum.HipHeight) or 2
                        bottomWorld = hrp.Position - Vector3.new(0, (hrp.Size.Y / 2) + hipHeight, 0)
                    else
                        local sz = char:GetExtentsSize()
                        local piv = char:GetPivot()
                        topWorld = piv.Position + Vector3.new(0, sz.Y / 2, 0)
                        bottomWorld = piv.Position - Vector3.new(0, sz.Y / 2, 0)
                    end

                    local topPos, topOnScreen = Camera:WorldToViewportPoint(topWorld)
                    local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(bottomWorld)

                    if topOnScreen and bottomOnScreen then
                        local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                        local boxWidth = boxHeight * 0.55
                        local x = topPos.X - (boxWidth / 2)
                        local y = topPos.Y
                        local curHp, maxHp = GetHealthData(char)

                        if Config.EspBoxes then
                            if not d.highlight or d.highlight.Parent ~= char then
                                pcall(function()
                                    if d.highlight then d.highlight:Destroy() end
                                end)
                                d.highlight = Instance.new("Highlight")
                                d.highlight.Parent = char
                            end
                            d.highlight.Enabled = true
                            d.highlight.FillTransparency = 1
                            d.highlight.OutlineTransparency = 0
                            d.highlight.OutlineColor = dynamicColor
                            d.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

                            d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x + boxWidth, y)
                            d.box[2].From = Vector2.new(x + boxWidth, y); d.box[2].To = Vector2.new(x + boxWidth, y + boxHeight)
                            d.box[3].From = Vector2.new(x + boxWidth, y + boxHeight); d.box[3].To = Vector2.new(x, y + boxHeight)
                            d.box[4].From = Vector2.new(x, y + boxHeight); d.box[4].To = Vector2.new(x, y)
                            for _, l in pairs(d.box) do l.Visible = true; l.Color = dynamicColor end
                        else
                            if d.highlight then d.highlight.Enabled = false end
                            for _, l in pairs(d.box) do l.Visible = false end
                        end

                        d.tracer.Visible = Config.EspTracers
                        if Config.EspTracers then
                            d.tracer.Color = dynamicColor
                            d.tracer.From = Vector2.new(vpSize.X / 2, vpSize.Y)
                            d.tracer.To = Vector2.new(topPos.X, y + boxHeight)
                        end

                        d.text.Visible = (Config.EspNames or Config.EspDist)
                        if d.text.Visible then
                            d.text.Color = dynamicColor
                            local namePart = Config.EspNames and (player.DisplayName or player.Name) or ""
                            local distPart = Config.EspDist and (" [" .. math.floor(realDist) .. "м]") or ""
                            local teamTag = isTeammate and " [TEAM]" or ""
                            d.text.Text = namePart .. distPart .. teamTag
                            d.text.Position = Vector2.new(topPos.X, y - 16)
                        end

                        d.hpBg.Visible = Config.EspHP
                        d.hpBar.Visible = Config.EspHP
                        if Config.EspHP then
                            local hp_val = math.clamp(curHp / maxHp, 0, 1)
                            d.hpBg.From = Vector2.new(x - 5, y + boxHeight); d.hpBg.To = Vector2.new(x - 5, y)
                            d.hpBar.From = Vector2.new(x - 5, y + boxHeight)
                            d.hpBar.To = Vector2.new(x - 5, y + boxHeight - (boxHeight * hp_val))
                            d.hpBar.Color = Color3.fromHSV(hp_val * 0.3, 1, 1)
                        end
                        isRendered = true
                    else
                        if Config.Aim and realDist <= Config.ArrowDistance then
                            table.insert(offScreenTargets, {pos = targetPos, dist = realDist})
                        end
                    end
                end
            end
            if not isRendered then
                if d.highlight then d.highlight.Enabled = false end
                for _, l in pairs(d.box) do l.Visible = false end
                d.tracer.Visible = false; d.text.Visible = false
                d.hpBg.Visible = false; d.hpBar.Visible = false
            end
        end
    end

    for bot, _ in pairs(BotEsp) do
        if not bot or not bot.Parent then RemoveBotEsp(bot) end
    end
    for _, bot in ipairs(BotsCache) do
        if bot and bot.Parent and not BotEsp[bot] then CreateBotEsp(bot) end
    end

    for bot, d in pairs(BotEsp) do
        local isRendered = false
        if myHrp and bot and bot.Parent then
            local head = bot:FindFirstChild("Head")
            local hrp = bot:FindFirstChild("HumanoidRootPart")
            local hum = bot:FindFirstChildOfClass("Humanoid")
            local botPos = GetBotPos(bot)
            if botPos then
                local realDist = (botPos - myPos).Magnitude
                if realDist <= Config.BotEspDistance then
                    local topWorld, bottomWorld
                    if head and hrp then
                        topWorld = head.Position + Vector3.new(0, head.Size.Y / 2, 0)
                        local hipHeight = (hum and hum.HipHeight) or 2
                        bottomWorld = hrp.Position - Vector3.new(0, (hrp.Size.Y / 2) + hipHeight, 0)
                    else
                        local sz = bot:GetExtentsSize()
                        local piv = bot:GetPivot()
                        topWorld = piv.Position + Vector3.new(0, sz.Y / 2, 0)
                        bottomWorld = piv.Position - Vector3.new(0, sz.Y / 2, 0)
                    end
                    local topPos, topOnScreen = Camera:WorldToViewportPoint(topWorld)
                    local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(bottomWorld)

                    if topOnScreen and bottomOnScreen then
                        local boxHeight = math.abs(topPos.Y - bottomPos.Y)
                        local boxWidth = boxHeight * 0.55
                        local x = topPos.X - (boxWidth / 2)
                        local y = topPos.Y
                        local curHp, maxHp = GetBotHP(bot)

                        if Config.BotHighlight or Config.BotEspBoxes then
                            if not d.highlight or d.highlight.Parent ~= bot then
                                pcall(function()
                                    if d.highlight then d.highlight:Destroy() end
                                end)
                                d.highlight = Instance.new("Highlight")
                                d.highlight.Parent = bot
                            end
                            d.highlight.Enabled = true
                            d.highlight.FillTransparency = 1
                            d.highlight.OutlineTransparency = 0
                            d.highlight.OutlineColor = COLOR_BOT
                            d.highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        else
                            if d.highlight then d.highlight.Enabled = false end
                        end

                        if Config.BotEspBoxes then
                            d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x + boxWidth, y)
                            d.box[2].From = Vector2.new(x + boxWidth, y); d.box[2].To = Vector2.new(x + boxWidth, y + boxHeight)
                            d.box[3].From = Vector2.new(x + boxWidth, y + boxHeight); d.box[3].To = Vector2.new(x, y + boxHeight)
                            d.box[4].From = Vector2.new(x, y + boxHeight); d.box[4].To = Vector2.new(x, y)
                            for _, l in pairs(d.box) do l.Visible = true; l.Color = COLOR_BOT end
                        else
                            for _, l in pairs(d.box) do l.Visible = false end
                        end

                        d.tracer.Visible = Config.BotEspTracers
                        if Config.BotEspTracers then
                            d.tracer.Color = COLOR_BOT
                            d.tracer.From = Vector2.new(vpSize.X / 2, vpSize.Y)
                            d.tracer.To = Vector2.new(topPos.X, y + boxHeight)
                        end

                        d.text.Visible = (Config.BotEspNames or Config.BotEspDist)
                        if d.text.Visible then
                            d.text.Color = COLOR_BOT
                            local namePart = Config.BotEspNames and ("🤖 " .. bot.Name) or ""
                            local distPart = Config.BotEspDist and (" [" .. math.floor(realDist) .. "м]") or ""
                            d.text.Text = namePart .. distPart
                            d.text.Position = Vector2.new(topPos.X, y - 16)
                        end

                        d.hpBg.Visible = Config.BotEspHP
                        d.hpBar.Visible = Config.BotEspHP
                        if Config.BotEspHP then
                            local hp_val = math.clamp(curHp / maxHp, 0, 1)
                            d.hpBg.From = Vector2.new(x - 5, y + boxHeight); d.hpBg.To = Vector2.new(x - 5, y)
                            d.hpBar.From = Vector2.new(x - 5, y + boxHeight)
                            d.hpBar.To = Vector2.new(x - 5, y + boxHeight - (boxHeight * hp_val))
                            d.hpBar.Color = Color3.fromHSV(hp_val * 0.3, 1, 1)
                        end
                        isRendered = true
                    end
                end
            end
        end
        if not isRendered then
            if d.highlight then d.highlight.Enabled = false end
            for _, l in pairs(d.box) do l.Visible = false end
            d.tracer.Visible = false; d.text.Visible = false
            d.hpBg.Visible = false; d.hpBar.Visible = false
        end
    end

    if Config.LastHitDir and lastHitPos then
        local age = tick() - lastHitTime
        if age <= Config.LastHitDuration then
            local relPos = Camera.CFrame:PointToObjectSpace(lastHitPos)
            local angle = math.atan2(relPos.X, -relPos.Z)
            local r = 80
            local size = 18
            local pTip = screenCenter + Vector2.new(math.sin(angle), math.cos(angle)) * (r + size)
            local pL = screenCenter + Vector2.new(math.sin(angle - 0.4), math.cos(angle - 0.4)) * r
            local pR = screenCenter + Vector2.new(math.sin(angle + 0.4), math.cos(angle + 0.4)) * r
            HitDirArrow.PointA = pTip; HitDirArrow.PointB = pL; HitDirArrow.PointC = pR
            HitDirArrow.Visible = true
            HitDirText.Position = screenCenter + Vector2.new(0, r + 30)
            HitDirText.Text = "⚠️ УДАР"
            HitDirText.Visible = true
        else
            HitDirArrow.Visible = false; HitDirText.Visible = false
        end
    else
        HitDirArrow.Visible = false; HitDirText.Visible = false
    end

    if Config.WaypointEnabled and Config.WaypointPos then
        local pos2d, onS = Camera:WorldToViewportPoint(Config.WaypointPos)
        local myH2 = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local dist = myH2 and (Config.WaypointPos - myH2.Position).Magnitude or 0
        if onS then
            WaypointCircle.Position = Vector2.new(pos2d.X, pos2d.Y); WaypointCircle.Radius = 15
            WaypointCircle.Visible = true
            WaypointText.Position = Vector2.new(pos2d.X, pos2d.Y - 25)
            WaypointText.Text = Config.WaypointLabel .. " " .. math.floor(dist) .. "м"
            WaypointText.Visible = true; WaypointLine.Visible = false
        else
            local relPos = Camera.CFrame:PointToObjectSpace(Config.WaypointPos)
            local angle = math.atan2(relPos.X, -relPos.Z)
            WaypointLine.From = screenCenter + Vector2.new(math.sin(angle), math.cos(angle)) * 40
            WaypointLine.To = screenCenter + Vector2.new(math.sin(angle), math.cos(angle)) * 80
            WaypointLine.Visible = true; WaypointCircle.Visible = false
            WaypointText.Position = WaypointLine.To + Vector2.new(0, -20)
            WaypointText.Text = Config.WaypointLabel .. " " .. math.floor(dist) .. "м"
            WaypointText.Visible = true
        end
    else
        WaypointCircle.Visible = false; WaypointLine.Visible = false; WaypointText.Visible = false
    end

    if Config.CountdownEnabled and Config.CountdownEndTime > 0 then
        local diff = Config.CountdownEndTime - os.time()
        if diff > 0 then
            local d2 = math.floor(diff / 86400)
            local h2 = math.floor((diff % 86400) / 3600)
            local m2 = math.floor((diff % 3600) / 60)
            CountdownText.Text = string.format("⏰ %dd %dh %dm", d2, h2, m2)
            CountdownText.Visible = true
        else
            CountdownText.Text = "⏰ ВАЙП!"
            CountdownText.Color = Color3.fromRGB(255, 50, 50)
            CountdownText.Visible = true
        end
    else
        CountdownText.Visible = false
    end

    if Config.Aim and #offScreenTargets > 0 then
        table.sort(offScreenTargets, function(a, b) return a.dist < b.dist end)
        local maxA = math.min(#offScreenTargets, #IndicatorArrows)
        for i = 1, maxA do
            local td = offScreenTargets[i]
            local tri = IndicatorArrows[arrowIndex]
            local relPos = Camera.CFrame:PointToObjectSpace(td.pos)
            local angle = math.atan2(relPos.X, -relPos.Z)
            local dr = Config.AimRadius
            local al = 10
            local hw = 0.16
            local bX, bY = math.sin(angle), math.cos(angle)
            local pX, pY = math.cos(angle), -math.sin(angle)
            local pTip = Vector2.new(screenCenter.X + bX * (dr + al), screenCenter.Y + bY * (dr + al))
            local blX, blY = bX + pX * hw, bY + pY * hw
            local lL = math.sqrt(blX * blX + blY * blY)
            local pL = Vector2.new(screenCenter.X + (blX / lL) * dr, screenCenter.Y + (blY / lL) * dr)
            local brX, brY = bX - pX * hw, bY - pY * hw
            local lR = math.sqrt(brX * brX + brY * brY)
            local pR = Vector2.new(screenCenter.X + (brX / lR) * dr, screenCenter.Y + (brY / lR) * dr)
            local prox = math.clamp(1 - (td.dist / Config.ArrowDistance), 0, 1)
            tri.Visible = true
            tri.Color = COLOR_DIM:Lerp(COLOR_ACCENT, prox)
            tri.PointA = pTip; tri.PointB = pL; tri.PointC = pR
            arrowIndex = arrowIndex + 1
        end
    end
end)

WindUI:Notify({
    Title = "KIXDEV HUB v39.5",
    Content = "Годмод удален. Боты исправлены!",
    Icon = "solar:check-circle-bold",
    Duration = 5
})
