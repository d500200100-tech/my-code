-- ============================================================
-- RUSTY HACK | AIM & ESP (С HP И КРУЖКОМ)
-- ============================================================

local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")

local Config = {
    Aim = false,
    AimRadius = 150,
    AimDist = 500,
    TeamCheck = true,
    
    ESP = false,
    ESPBoxes = true,
    ESPNames = true,
    ESPDist = true,
    ESPHP = true,     -- Полоска HP
    ESPDistance = 3000,
    DrawFOV = true    -- Кружок FOV
}

-- Кружок FOV
local FovCircle = Drawing.new("Circle")
FovCircle.Color = Color3.fromRGB(255, 100, 0)
FovCircle.Thickness = 1.5
FovCircle.Filled = false
FovCircle.NumSides = 60
FovCircle.Visible = false

-- ============================================================
-- ФУНКЦИИ
-- ============================================================
local function GetClosestTarget()
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    local best, bd = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and not (Config.TeamCheck and p.Team == LocalPlayer.Team) then
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                if hrp and head then
                    local d = (hrp.Position - myPos).Magnitude
                    if d <= Config.AimDist then
                        local pos, onS = Camera:WorldToViewportPoint(head.Position)
                        if onS then
                            local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                            if mag <= Config.AimRadius and mag < bd then
                                bd = mag; best = head
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- ============================================================
-- МЕНЮ
-- ============================================================
local Window = WindUI:CreateWindow({
    Title = "RUSTY HACK",
    Author = "Aim & ESP",
    Folder = "RustyHack",
    Theme = "Dark",
    Size = UDim2.fromOffset(400, 400),
})

Window:SetToggleKey(Enum.KeyCode.RightShift)

local MainTab = Window:Tab({ Title = "Aim & ESP", Icon = "crosshair" })

MainTab:Toggle({ Title = "🎯 AIMBOT", Value = false, Callback = function(s) Config.Aim = s end })
MainTab:Toggle({ Title = "⭕ Показывать FOV", Value = true, Callback = function(s) Config.DrawFOV = s end })
MainTab:Slider({ Title = "FOV (Радиус)", Value = { Min = 10, Max = 800, Default = 150 }, Callback = function(v) Config.AimRadius = v end })
MainTab:Slider({ Title = "Дальность Аима", Value = { Min = 50, Max = 5000, Default = 500 }, Callback = function(v) Config.AimDist = v end })
MainTab:Toggle({ Title = "🛡️ Проверка тимы", Value = true, Callback = function(s) Config.TeamCheck = s end })

MainTab:Space()

MainTab:Toggle({ Title = "👁️ ESP (Wallhack)", Value = false, Callback = function(s) Config.ESP = s end })
MainTab:Toggle({ Title = "📦 Боксы", Value = true, Callback = function(s) Config.ESPBoxes = s end })
MainTab:Toggle({ Title = "🏷️ Ники", Value = true, Callback = function(s) Config.ESPNames = s end })
MainTab:Toggle({ Title = "📏 Дистанция", Value = true, Callback = function(s) Config.ESPDist = s end })
MainTab:Toggle({ Title = "❤️ Полоска HP", Value = true, Callback = function(s) Config.ESPHP = s end })
MainTab:Slider({ Title = "Макс. дистанция ESP", Value = { Min = 100, Max = 10000, Default = 3000 }, Callback = function(v) Config.ESPDistance = v end })

-- ============================================================
-- РЕНДЕР
-- ============================================================
local PlayerESP = {}

local function CreateESP(player)
    if PlayerESP[player] then return end
    local d = {
        box = {Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line"), Drawing.new("Line")},
        text = Drawing.new("Text"),
        hpBg = Drawing.new("Line"),
        hpBar = Drawing.new("Line")
    }
    for _, l in pairs(d.box) do l.Thickness = 1; l.Color = Color3.fromRGB(255, 50, 50) end
    d.text.Size = 14; d.text.Center = true; d.text.Outline = true; d.text.Color = Color3.fromRGB(255, 255, 255)
    
    d.hpBg.Thickness = 3; d.hpBg.Color = Color3.fromRGB(0, 0, 0) -- Черный фон
    d.hpBar.Thickness = 2; d.hpBar.Color = Color3.fromRGB(0, 255, 0) -- Зеленая полоска
    
    PlayerESP[player] = d
end

local function RemoveESP(player)
    if PlayerESP[player] then
        for _, l in pairs(PlayerESP[player].box) do l:Remove() end
        PlayerESP[player].text:Remove()
        PlayerESP[player].hpBg:Remove()
        PlayerESP[player].hpBar:Remove()
        PlayerESP[player] = nil
    end
end

for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then CreateESP(p) end end
Players.PlayerAdded:Connect(CreateESP)
Players.PlayerRemoving:Connect(RemoveESP)

RunService.RenderStepped:Connect(function()
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myHrp and myHrp.Position or Vector3.zero
    
    -- Отрисовка кружка FOV
    FovCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FovCircle.Radius = Config.AimRadius
    FovCircle.Visible = Config.Aim and Config.DrawFOV

    -- АИМБОТ
    if Config.Aim then
        local target = GetClosestTarget()
        if target then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    end
    
    -- ESP
    for player, d in pairs(PlayerESP) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local isRendered = false
        
        if Config.ESP and myHrp and hrp and head and hum and hum.Health > 0 then
            local dist = (hrp.Position - myPos).Magnitude
            if dist <= Config.ESPDistance and not (Config.TeamCheck and player.Team == LocalPlayer.Team) then
                local topPos, onTop = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                local botPos, onBot = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 2, 0))
                
                if onTop and onBot then
                    local h = math.abs(topPos.Y - botPos.Y)
                    local w = h * 0.6
                    local x = topPos.X - (w / 2)
                    local y = topPos.Y
                    
                    if Config.ESPBoxes then
                        d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x + w, y)
                        d.box[2].From = Vector2.new(x + w, y); d.box[2].To = Vector2.new(x + w, y + h)
                        d.box[3].From = Vector2.new(x + w, y + h); d.box[3].To = Vector2.new(x, y + h)
                        d.box[4].From = Vector2.new(x, y + h); d.box[4].To = Vector2.new(x, y)
                        for _, l in pairs(d.box) do l.Visible = true end
                    else
                        for _, l in pairs(d.box) do l.Visible = false end
                    end
                    
                    d.text.Visible = (Config.ESPNames or Config.ESPDist)
                    if d.text.Visible then
                        local name = Config.ESPNames and player.Name or ""
                        local distTxt = Config.ESPDist and (" ["..math.floor(dist).."m]") or ""
                        d.text.Text = name .. distTxt
                        d.text.Position = Vector2.new(topPos.X, y - 16)
                    end

                    if Config.ESPHP then
                        local hpPct = hum.Health / hum.MaxHealth
                        d.hpBg.From = Vector2.new(x - 6, y); d.hpBg.To = Vector2.new(x - 6, y + h)
                        d.hpBar.From = Vector2.new(x - 6, y + h - (h * hpPct)); d.hpBar.To = Vector2.new(x - 6, y + h)
                        d.hpBar.Color = Color3.fromHSV(hpPct * 0.3, 1, 1) -- Меняет цвет от зеленого к красному
                        d.hpBg.Visible = true; d.hpBar.Visible = true
                    else
                        d.hpBg.Visible = false; d.hpBar.Visible = false
                    end
                    
                    isRendered = true
                end
            end
        end
        
        if not isRendered then
            for _, l in pairs(d.box) do l.Visible = false end
            d.text.Visible = false
            d.hpBg.Visible = false; d.hpBar.Visible = false
        end
    end
end)
