local CachedCombatEvent = nil
local function GetCombatEvent()
if CachedCombatEvent then return CachedCombatEvent end
for _, obj in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
if obj:IsA("RemoteEvent") and (obj.Name:lower():find("hit") or obj.Name:lower():find("damage") or obj.Name:lower():find("projectile") or obj.Name:lower():find("shoot")) then
CachedCombatEvent = obj
return obj
end
end
return nil
end
-- Проверки игроков
local function IsValid(p)
if p and p ~= LocalPlayer and p.Character and p.Character:FindFirstChild(Config.AimPart) and p.Character:FindFirstChild("Humanoid") then
if p.Character.Humanoid.Health > 0 and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
if Config.TeamCheck and p.Team == LocalPlayer.Team and LocalPlayer.Team ~= nil then return false end
local dist = (p.Character[Config.AimPart].Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
if dist <= Config.Distance then return true end
end
end
return false
end
-- Проверка препятствий для Килл Ауры
local function IsVisible(targetPart)
if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("Head") then return false end
local ray = Ray.new(LocalPlayer.Character.Head.Position, (targetPart.Position - LocalPlayer.Character.Head.Position).Unit * 50)
local hit, pos = workspace:FindPartOnRayWithIgnoreList(ray, {LocalPlayer.Character, targetPart.Parent})
return hit == nil
end
-- Система Aim Lock
local function GetClosest()
if CurrentTarget and IsValid(CurrentTarget) then
local pos, onScreen = Camera:WorldToViewportPoint(CurrentTarget.Character[Config.AimPart].Position)
local mag = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
if onScreen and mag <= Config.FOV then return CurrentTarget end
end
local closest, shortestDist = nil, math.huge
local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
for _, p in pairs(game.Players:GetPlayers()) do
if IsValid(p) then
local pos, onScreen = Camera:WorldToViewportPoint(p.Character[Config.AimPart].Position)
if onScreen then
local mag = (Vector2.new(pos.X, pos.Y) - center).Magnitude
if mag <= Config.FOV and mag < shortestDist then shortestDist = mag; closest = p end
end
end
end
CurrentTarget = closest; return closest
end
