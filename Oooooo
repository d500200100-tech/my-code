-- ЕДИНЫЙ ЦИКЛ СИНХРОНИЗАЦИИ
-- ===========================================================================
RunService.Heartbeat:Connect(function()
if AimCircle.Visible then
AimCircle.Size = UDim2.new(0, Config.AimRadius * 2, 0, Config.AimRadius * 2)
end
if SilentCircle.Visible then
SilentCircle.Size = UDim2.new(0, Config.SilentRadius * 2, 0, Config.SilentRadius * 2)
end
local targetPlayer = GetClosestPlayerInCircle(Config.SilentRadius)
for _, p in ipairs(Players:GetPlayers()) do
if p ~= LocalPlayer and p.Character then
-- Хитбоксы
if p.Character:FindFirstChild("HumanoidRootPart") then
local root = p.Character.HumanoidRootPart
if Config.Silent and p == targetPlayer then
root.Size = Vector3.new(13, 13, 13)
root.CanCollide = false
elseif Config.Hitbox then
root.Size = Vector3.new(8, 8, 8)
root.CanCollide = true
else
root.Size = Vector3.new(2, 2, 2)
root.CanCollide = true
end
end
local els = EspObjects[p]
if els and Config.Esp and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
local char = p.Character
local head = char.Head
local root = char.HumanoidRootPart
local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
if myRoot then
local dist = (myRoot.Position - root.Position).Magnitude
if dist <= Config.EspDistance then
-- 🔥 АБСОЛЮТНЫЙ ФИКС: Привязка только к костям Head и HumanoidRootPart
-- Добавлено смещение +1.2 вверх, чтобы поднять верхнюю рамку БОЛЬШЕ ГОЛОВЫ по вашей просьбе
local top3D = head.Position + Vector3.new(0, 1.2, 0)
-- Смещение вниз рассчитывается от центра тела, гарантируя, что низ зафиксируется на ногах, а не под землей
local bottom3D = root.Position + Vector3.new(0, -3.0, 0)
local topPos, topOnScreen = Camera:WorldToViewportPoint(top3D)
local bottomPos, bottomOnScreen = Camera:WorldToViewportPoint(bottom3D)
if topOnScreen and bottomOnScreen then
local color = Color3.fromRGB(255, 50, 50)
local boxHeight = math.abs(topPos.Y - bottomPos.Y)
if boxHeight < 24 then boxHeight = 24 end
local boxWidth = boxHeight * 0.65
local screenPosX = topPos.X - (boxWidth / 2)
local screenPosY = topPos.Y
-- 1. Отрисовка 2D бокса (Сидит идеально на игроке, верх приподнят)
els.Box.Size = UDim2.new(0, boxWidth, 0, boxHeight)
els.Box.Position = UDim2.new(0, screenPosX, 0, screenPosY)
els.BoxStroke.Color = color
els.Box.Visible = true
-- 2. Ники + Дистанция строго над поднятой рамкой
els.Tag.Text = string.format("%s [%dм]", p.DisplayName or p.Name, math.floor(dist))
els.Tag.Position = UDim2.new(0, topPos.X, 0, screenPosY - 4)
els.Tag.TextColor3 = color
els.Tag.Visible = true
-- 3. Вертикальное ХП бар
local health = char.Humanoid.Health
local maxHealth = char.Humanoid.MaxHealth
local healthPct = math.clamp(health / maxHealth, 0, 1)
els.HpBg.Size = UDim2.new(0, 3, 0, boxHeight)
els.HpBg.Position = UDim2.new(0, screenPosX - 6, 0, screenPosY)
els.HpBg.Visible = true
els.HpFill.Size = UDim2.new(1, 0, healthPct, 0)
els.HpFill.Position = UDim2.new(0, 0, 1 - healthPct, 0)
els.HpFill.BackgroundColor3 = Color3.fromRGB(255 * (1 - healthPct), 255 * healthPct, 0)
-- 4. Линия-Трейсер ведет ровно к нижней грани поднятого бокса (к ногам)
els.DrawingLine.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
els.DrawingLine.To = Vector2.new(topPos.X, bottomPos.Y)
els.DrawingLine.Color = color
els.DrawingLine.Visible = true
continue
end
end
end
end
if els then
els.Box.Visible = false
els.Tag.Visible = false
els.HpBg.Visible = false
els.DrawingLine.Visible = false
end
end
end
end)
