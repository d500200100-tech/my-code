hpFill.Parent = hpBg
elements.HpFill = hpFill
local drawLine = Drawing.new("Line")
drawLine.Thickness = 1.2
drawLine.Color = Color3.fromRGB(255, 50, 50)
drawLine.Transparency = 1
drawLine.Visible = false
elements.DrawingLine = drawLine
