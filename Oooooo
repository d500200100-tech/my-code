local gHook
gHook = hookmetamethod(game, "__namecall", function(self, ...)
local args = {...}
local method = getnamecallmethod()
if method == "FireServer" then
local nameLower = self.Name:lower()
if nameLower:find("shoot") or nameLower:find("hit") or nameLower:find("bullet") or nameLower:find("fire") then
local targetPlayer = GetClosestPlayerInCircle(Config.SilentRadius)
if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
local head = targetPlayer.Character.Head
if Config.OneShot then
for i = 1, 10 do
if typeof(args) == "Vector3" then args = head.Position end
gHook(self, unpack(args))
end
return
elseif Config.Silent then
if typeof(args) == "Vector3" then args = head.Position end
return gHook(self, unpack(args))
end
end
end
if Config.NoRecoil and (nameLower:find("recoil") or nameLower:find("sway") or nameLower:find("shake")) then
return nil
end
end
return gHook(self, ...)
end)
