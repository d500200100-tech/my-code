end
for _, p in ipairs(Players:GetPlayers()) do if p ~= LocalPlayer then CreatePlayer2DEsp(p) end end
Players.PlayerAdded:Connect(function(p) if p ~= LocalPlayer then CreatePlayer2DEsp(p) end end)
Players.PlayerRemoving:Connect(function(p)
if EspObjects[p] then
if EspObjects[p].DrawingLine then EspObjects[p].DrawingLine:Remove() end
for _, el in pairs(EspObjects[p]) do if typeof(el) == "Instance" then el:Destroy() end end
EspObjects[p] = nil
end
end)
