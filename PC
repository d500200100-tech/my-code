-- Функции поиска
local function GetHealthData(char)
    if not char then return 100, 100 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function GetAimPart(char)
    if not char then return nil end
    if Config.AimTargetPart == "Head" then return char:FindFirstChild("Head")
    elseif Config.AimTargetPart == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    else return char:FindFirstChild("HumanoidRootPart") end
end

-- ИСПРАВЛЕННЫЙ АИМ (БЕЗ ТРЯСКИ)
local function GetClosestTarget(maxFOV, maxDist)
    maxDist = maxDist or Config.EspDistance
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    local best, bd = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local myPos = myH.Position
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local char = p.Character
            local h = char:FindFirstChild("HumanoidRootPart")
            if h then
                local d = (h.Position - myPos).Magnitude
                if d <= maxDist then
                    local targetPart = GetAimPart(char)
                    if targetPart then
                        local pos, onS = Camera:WorldToViewportPoint(targetPart.Position)
                        if onS then
                            local mag = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            if mag <= maxFOV and mag < bd then
                                local hp = GetHealthData(char)
                                if hp > 0 then
                                    bd = mag; best = targetPart
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Боты
local BotsCache = {}
local function IsPlayerChar(m) 
    return Players:GetPlayerFromCharacter(m) ~= nil or string.find(string.lower(m.Name), "sleeper")
end

local function RefreshBots()
    local l = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and not IsPlayerChar(o) then
            local hum = o:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and o:FindFirstChild("HumanoidRootPart") then
                table.insert(l, o)
            end
        end
    end
    BotsCache = l
end
task.spawn(function() RefreshBots(); while task.wait(3) do RefreshBots() end end)

local function GetClosestBot(maxFOV, maxDist)
    maxDist = maxDist or 1000
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    if #BotsCache == 0 then return nil end
    local best, bd = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    local myPos = myH.Position
    for _, bot in ipairs(BotsCache) do
        if bot and bot.Parent then
            local p3 = bot:FindFirstChild("HumanoidRootPart")
            if p3 then
                local d = (p3.Position - myPos).Magnitude
                if d <= maxDist then
                    local pos, onS = Camera:WorldToViewportPoint(p3.Position)
                    if onS then
                        local mag = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if mag <= maxFOV and mag < bd then
                            local hp = GetHealthData(bot)
                            if hp > 0 then
                                local part = bot:FindFirstChild("Head") or p3
                                bd = mag; best = part
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

