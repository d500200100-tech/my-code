    if Config.SkeletonEsp then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and SkeletonLines[p] then
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and (hrp.Position - myPos).Magnitude <= Config.EspDistance then
                    local links = SKELETON_LINKS
                    if not char:FindFirstChild("UpperTorso") and char:FindFirstChild("Torso") then links = SKELETON_R6 end
                    for i, link in ipairs(links) do
                        local l = SkeletonLines[p][i]
                        if l then
                            local p1 = char:FindFirstChild(link[1])
                            local p2 = char:FindFirstChild(link[2])
                            if p1 and p2 then
                                local v1, on1 = Camera:WorldToViewportPoint(p1.Position)
                                local v2, on2 = Camera:WorldToViewportPoint(p2.Position)
                                if on1 and on2 then
                                    l.From = Vector2.new(v1.X, v1.Y); l.To = Vector2.new(v2.X, v2.Y)
                                    l.Color = COLOR_SKEL; l.Thickness = Config.SkeletonThickness; l.Visible = true
                                else l.Visible = false end
                            else l.Visible = false end
                        end
                    end
                else
                    for _, l in pairs(SkeletonLines[p]) do l.Visible = false end
                end
            end
        end
    else
        for _, lines in pairs(SkeletonLines) do
            for _, l in pairs(lines) do l.Visible = false end
        end
    end
end)

