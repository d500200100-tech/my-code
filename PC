local BotESP = {}
local PlayerESP = {}

RunService.RenderStepped:Connect(function()
    if menuHidden then return end
    
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myHrp and myHrp.Position or Vector3.zero
    local mousePos = UserInputService:GetMouseLocation()
    local vpSize = Camera.ViewportSize
    local screenCenter = Vector2.new(vpSize.X / 2, vpSize.Y / 2)

    if AimCircle.Visible then AimCircle.Position = mousePos; AimCircle.Radius = Config.AimRadius end
    if BotAimCircle.Visible then BotAimCircle.Position = mousePos; BotAimCircle.Radius = Config.BotAimRadius end

    -- ЖЁСТКИЙ АИМ (БЕЗ ТРЯСКИ)
    if Config.Aim then
        local t = GetClosestTarget(Config.AimRadius, Config.AimDistance)
        if t then 
            pcall(function()
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position)
            end)
        end
    end
    if Config.BotAim then
        local bT = GetClosestBot(Config.BotAimRadius, Config.BotAimDistance)
        if bT then 
            pcall(function()
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, bT.Position)
            end)
        end
    end

    -- Метка
    if Config.WaypointEnabled and Config.WaypointPos then
        local pos2d, onS = Camera:WorldToViewportPoint(Config.WaypointPos)
        local dist = myHrp and (Config.WaypointPos - myHrp.Position).Magnitude or 0
        if onS then
            WaypointText.Position = Vector2.new(pos2d.X, pos2d.Y - 25)
            WaypointText.Text = "Метка " .. math.floor(dist) .. "м"
            WaypointText.Visible = true; WaypointLine.Visible = false
        else
            local relPos = Camera.CFrame:PointToObjectSpace(Config.WaypointPos)
            local angle = math.atan2(relPos.X, -relPos.Z)
            WaypointLine.From = screenCenter + Vector2.new(math.sin(angle), math.cos(angle)) * 40
            WaypointLine.To = screenCenter + Vector2.new(math.sin(angle), math.cos(angle)) * 80
            WaypointLine.Visible = true
            WaypointText.Position = WaypointLine.To + Vector2.new(0, -20)
            WaypointText.Text = "Метка " .. math.floor(dist) .. "м"
            WaypointText.Visible = true
        end
    else
        WaypointLine.Visible = false; WaypointText.Visible = false
    end

    -- ESP Ботов
    for bot, _ in pairs(BotESP) do
        if not bot or not bot.Parent then
            for _, l in pairs(BotESP[bot].box) do l:Remove() end
            BotESP[bot].text:Remove(); BotESP[bot].hpBg:Remove(); BotESP[bot].hpBar:Remove()
            BotESP[bot] = nil
        end
    end
    for _, bot in ipairs(BotsCache) do
        if bot and bot.Parent and not BotESP[bot] then
            local d = { box = {}, text = Drawing.new("Text"), hpBg = Drawing.new("Line"), hpBar = Drawing.new("Line") }
            for i=1,4 do local l = Drawing.new("Line"); l.Color = COLOR_BOT; l.Thickness = 1.5; table.insert(d.box, l) end
            d.text.Size = 13; d.text.Center = true; d.text.Outline = true; d.text.Color = COLOR_BOT
            d.hpBg.Thickness = 3; d.hpBg.Color = Color3.fromRGB(0,0,0)
            d.hpBar.Thickness = 2; d.hpBar.Color = Color3.fromRGB(0,255,0)
            BotESP[bot] = d
        end
    end
    for bot, d in pairs(BotESP) do
        local isR = false
        if myHrp and bot and bot.Parent then
            local head = bot:FindFirstChild("Head")
            local hrp = bot:FindFirstChild("HumanoidRootPart")
            local hum = bot:FindFirstChildOfClass("Humanoid")
            if head and hrp and hum then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= 1000 then 
                    local tp, on1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    local bp, on2 = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,2,0))
                    if on1 and on2 then
                        local h = math.abs(tp.Y - bp.Y); local w = h * 0.6
                        local x = tp.X - (w/2); local y = tp.Y
                        if Config.BotEspBoxes then
                            d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x+w, y)
                            d.box[2].From = Vector2.new(x+w, y); d.box[2].To = Vector2.new(x+w, y+h)
                            d.box[3].From = Vector2.new(x+w, y+h); d.box[3].To = Vector2.new(x, y+h)
                            d.box[4].From = Vector2.new(x, y+h); d.box[4].To = Vector2.new(x, y)
                            for _, l in pairs(d.box) do l.Visible = true end
                        else
                            for _, l in pairs(d.box) do l.Visible = false end
                        end
                        d.text.Visible = Config.BotEspNames
                        if Config.BotEspNames then
                            d.text.Text = bot.Name .. " [" .. math.floor(dist) .. "m]"
                            d.text.Position = Vector2.new(tp.X, y - 16)
                        end
                        if Config.BotEspHP then
                            local hpPct = hum.Health / hum.MaxHealth
                            d.hpBg.From = Vector2.new(x - 6, y); d.hpBg.To = Vector2.new(x - 6, y + h)
                            d.hpBar.From = Vector2.new(x - 6, y + h - (h * hpPct)); d.hpBar.To = Vector2.new(x - 6, y + h)
                            d.hpBar.Color = Color3.fromHSV(hpPct * 0.3, 1, 1)
                            d.hpBg.Visible = true; d.hpBar.Visible = true
                        else
                            d.hpBg.Visible = false; d.hpBar.Visible = false
                        end
                        isR = true
                    end
                end
            end
        end
        if not isR then 
            for _, l in pairs(d.box) do l.Visible = false end
            d.text.Visible = false; d.hpBg.Visible = false; d.hpBar.Visible = false
        end
    end

    -- ESP Игроков
    for player, _ in pairs(PlayerESP) do
        if not player.Parent or not player.Character then
            for _, l in pairs(PlayerESP[player].box) do l:Remove() end
            PlayerESP[player].text:Remove()
            if PlayerESP[player].hpBg then PlayerESP[player].hpBg:Remove() end
            if PlayerESP[player].hpBar then PlayerESP[player].hpBar:Remove() end
            if PlayerESP[player].tracer then PlayerESP[player].tracer:Remove() end
            PlayerESP[player] = nil
