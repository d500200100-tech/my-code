local COLOR_MAIN = Color3.fromRGB(230, 230, 230)
local COLOR_BOT = Color3.fromRGB(255, 60, 60)

local Config = {
    Aim = false, AimRadius = 150, AimDistance = 150,
    WallCheck = true, AimTargetPart = "Head",
    EspBoxes = false, EspNames = false, EspDist = false,
    EspHP = false, EspTracers = false, EspDistance = 3000,
    BotEspBoxes = false, BotEspNames = false, BotEspHP = false, BotEspDistance = 1000,
    SpeedEnabled = false, SpeedValue = 30,
    XRayEnabled = false, AlwaysDay = false
}

local menuHidden = false
local AimCircle = Drawing.new("Circle")
AimCircle.Color = COLOR_MAIN; AimCircle.Thickness = 1.5
AimCircle.Filled = false; AimCircle.Visible = false

local CurrentTarget = nil

local function GetHealthData(char)
    if not char then return 100, 100 end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then return hum.Health, hum.MaxHealth end
    return 100, 100
end

local function GetAimPart(char)
    if not char then return nil end
    if Config.AimTargetPart == "Head" then return char:FindFirstChild("Head")
    elseif Config.AimTargetPart == "Torso" then return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    else return char:FindFirstChild("HumanoidRootPart") end
end

local function isVisible(part, char)
    if not Config.WallCheck then return true end
    local myChar = LocalPlayer.Character
    if not myChar or not part then return false end
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {myChar, char}
    local rayResult = workspace:Raycast(Camera.CFrame.Position, (part.Position - Camera.CFrame.Position), rayParams)
    return rayResult == nil
end

local function GetClosestTarget(maxFOV, maxDist)
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    
    if CurrentTarget and CurrentTarget.Parent then
        local char = CurrentTarget.Parent
        local hp = GetHealthData(char)
        if hp > 0 and (CurrentTarget.Position - myH.Position).Magnitude <= maxDist and isVisible(CurrentTarget, char) then
            return CurrentTarget
        end
    end

    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            if char then
                local h = char:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - myPos).Magnitude
                    if d <= maxDist then
                        local pos, onS = Camera:WorldToViewportPoint(h.Position)
                        if onS then
                            local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                            if mag <= maxFOV and mag < bd then
                                local hp = GetHealthData(char)
                                if hp > 0 then
                                    local ap = GetAimPart(char)
                                    if ap and isVisible(ap, char) then bd = mag; best = ap end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Боты
local BotsCache = {}
local function RefreshBots()
    local l = {}
    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("Model") and not Players:GetPlayerFromCharacter(o) then
            local hum = o:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and o:FindFirstChild("HumanoidRootPart") then
                table.insert(l, o)
            end
        end
    end
    BotsCache = l
end
task.spawn(function() RefreshBots(); while task.wait(3) do RefreshBots() end end)

-- X-Ray
local XRayParts = {}
local function ToggleXRay(state)
    if state then
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and (obj.Name:lower():find("wall") or obj.Name:lower():find("foundation") or obj.Name:lower():find("door")) then
                if obj.Transparency < 0.5 then
                    table.insert(XRayParts, {part = obj, orig = obj.Transparency})
                    obj.Transparency = 0.5
                end
            end
        end
    else
        for _, data in ipairs(XRayParts) do
            if data.part and data.part.Parent then data.part.Transparency = data.orig end
        end
        XRayParts = {}
    end
end

