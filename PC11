-- АИМ И КРУЖОК
RunService.RenderStepped:Connect(function()
    if menuHidden then return end
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    if AimCircle.Visible then
        AimCircle.Position = screenCenter
        AimCircle.Radius = Config.AimRadius
    end
    if BotAimCircle.Visible then
        BotAimCircle.Position = screenCenter
        BotAimCircle.Radius = Config.BotAimRadius
    end

    if Config.Aim then
        local t = GetClosestTarget(Config.AimRadius, Config.AimDistance)
        if t then
            pcall(function()
                Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, t.Position), Config.AimSmooth)
            end)
        end
    end
end)

-- ESP И БОТЫ (60 КАДРОВ ЧЕРЕЗ RENDERSTEPPED)
local PlayerESP = {}
local BotESP = {}

RunService.RenderStepped:Connect(function()
