local BotsCache = {}
local function RefreshBots()
    local l = {}
    for _, o in ipairs(workspace:GetChildren()) do
        if o:IsA("Model") and not Players:GetPlayerFromCharacter(o) then
            local hum = o:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and o:FindFirstChild("HumanoidRootPart") then
                table.insert(l, o)
            end
        end
    end
    BotsCache = l
end
