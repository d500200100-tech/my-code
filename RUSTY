-- СКРЫТИЕ МЕНЮ
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        menuHidden = not menuHidden
        local windGui = game.CoreGui:FindFirstChild("WindUI")
        if windGui then windGui.Enabled = not menuHidden end
        AimCircle.Visible = (not menuHidden) and Config.Aim
    end
end)

-- === ЛОГИКА ===
RunService.RenderStepped:Connect(function()
    if menuHidden then return end
    
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        if Config.SpeedEnabled then hum.WalkSpeed = math.clamp(Config.SpeedValue, 16, 30) else hum.WalkSpeed = 16 end
    end

    if Config.AlwaysDay then
        pcall(function()
            Lighting.ClockTime = 14; Lighting.Brightness = 3; Lighting.GlobalShadows = false
            Lighting.FogStart = 0; Lighting.FogEnd = 1000000
        end)
    end

    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    if AimCircle.Visible then
        AimCircle.Position = screenCenter
        AimCircle.Radius = Config.AimRadius
    end
    
    if Config.Aim then
        local t = GetClosestTarget(Config.AimRadius, Config.AimDistance)
        if t then pcall(function() Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position) end) end
    end
end)

-- === ESP ИГРОКОВ (ФИКС 30 КАДРОВ) ===
local PlayerESP = {}

task.spawn(function()
    while task.wait(0.033) do 
        if menuHidden then continue end
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myHrp then continue end
        local myPos = myHrp.Position
        local screenBottom = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)

        for player, _ in pairs(PlayerESP) do
            if not player.Parent or not player.Character then
                for _, l in pairs(PlayerESP[player].box) do l:Remove() end
                PlayerESP[player].text:Remove(); PlayerESP[player].hpBg:Remove(); PlayerESP[player].hpBar:Remove(); PlayerESP[player].tracer:Remove()
                PlayerESP[player] = nil
            end
        end
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and not PlayerESP[p] then
                local d = { box = {}, text = Drawing.new("Text"), hpBg = Drawing.new("Line"), hpBar = Drawing.new("Line"), tracer = Drawing.new("Line") }
                for i=1,4 do local l = Drawing.new("Line"); l.Thickness = 1; table.insert(d.box, l) end
                d.text.Size = 13; d.text.Center = true; d.text.Outline = true
                d.hpBg.Thickness = 2; d.hpBg.Color = Color3.fromRGB(0,0,0)
                d.hpBar.Thickness = 2; d.tracer.Thickness = 1.5
                PlayerESP[p] = d
            end
        end
        for p, d in pairs(PlayerESP) do
            local isR = false
            if p.Character then
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local dist = (hrp.Position - myPos).Magnitude
                    if dist <= Config.EspDistance then 
                        local pos, onS = Camera:WorldToViewportPoint(hrp.Position)
                        if onS then
                            local boxHeight = 100 / dist
                            local boxWidth = boxHeight * 0.6
                            local x = pos.X - (boxWidth / 2)
                            local y = pos.Y - (boxHeight / 2)
                            
                            if Config.EspBoxes then
                                d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x+boxWidth, y); d.box[1].Visible = true
                                d.box[2].From = Vector2.new(x+boxWidth, y); d.box[2].To = Vector2.new(x+boxWidth, y+boxHeight); d.box[2].Visible = true
                                d.box[3].From = Vector2.new(x+boxWidth, y+boxHeight); d.box[3].To = Vector2.new(x, y+boxHeight); d.box[3].Visible = true
                                d.box[4].From = Vector2.new(x, y+boxHeight); d.box[4].To = Vector2.new(x, y); d.box[4].Visible = true
                            else for _, l in pairs(d.box) do l.Visible = false end end
                            
                            d.text.Visible = (Config.EspNames or Config.EspDist)
                            if d.text.Visible then
                                local name = Config.EspNames and p.Name or ""
                                local distTxt = Config.EspDist and (" [" .. math.floor(dist) .. "m]") or ""
                                d.text.Text = name .. distTxt; d.text.Position = Vector2.new(pos.X, y - 16)
                            end
                            
                            if Config.EspHP then
                                local hpPct = hum.Health / hum.MaxHealth
                                d.hpBg.From = Vector2.new(x - 4, y); d.hpBg.To = Vector2.new(x - 4, y + boxHeight); d.hpBg.Visible = true
                                d.hpBar.From = Vector2.new(x - 4, y + boxHeight - (boxHeight * hpPct)); d.hpBar.To = Vector2.new(x - 4, y + boxHeight)
                                d.hpBar.Color = Color3.fromHSV(hpPct * 0.3, 1, 1); d.hpBar.Visible = true
                            else d.hpBg.Visible = false; d.hpBar.Visible = false end

                            if Config.EspTracers then
                                d.tracer.From = screenBottom
                                d.tracer.To = Vector2.new(pos.X, y + boxHeight)
                                d.tracer.Color = COLOR_MAIN; d.tracer.Visible = true
                            else d.tracer.Visible = false end
                            isR = true
                        end
                    end
                end
            end
            if not isR then 
                for _, l in pairs(d.box) do l.Visible = false end
                d.text.Visible = false; d.hpBg.Visible = false; d.hpBar.Visible = false; d.tracer.Visible = false
            end
        end
    end
end)

WindUI:Notify({ Title = "RUSTY v3.2", Content = "ESP на лут убран. Только игроки!", Duration = 5 })
