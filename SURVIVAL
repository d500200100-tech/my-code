local WindUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/Footagesus/WindUI/main/dist/main.lua"))()
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local Config = {
    Aim = false, AimRadius = 150, AimDistance = 500, AimTargetPart = "Head",
    AimColor = "Синий",
    EspBoxes = false, EspBoxColor = "Синий", EspNames = false, EspHP = false, EspDist = false,
    EspDistance = 3000,
    AlwaysDay = false
}

-- Цвета
local COLOR_WHITE = Color3.fromRGB(255, 255, 255)
local COLOR_BLUE = Color3.fromRGB(0, 150, 255)

local AimCircle = Drawing.new("Circle")
AimCircle.Thickness = 1.5
AimCircle.Filled = false
AimCircle.Visible = false

-- Функция обновления цветов (Радуга / Синий / Белый)
local function UpdateColors()
    -- Аимбот
    if Config.AimColor == "Синий" then AimCircle.Color = COLOR_BLUE
    elseif Config.AimColor == "Белый" then AimCircle.Color = COLOR_WHITE
    elseif Config.AimColor == "Радужный" then AimCircle.Color = Color3.fromHSV((tick() * 0.5) % 1, 1, 1) end
end

-- Поиск игроков
local function GetClosestTarget(maxFOV, maxDist)
    maxDist = maxDist or Config.EspDistance
    local myH = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myH then return nil end
    local best, bd = nil, math.huge
    local c = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local myPos = myH.Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local char = p.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if char and hum and hum.Health > 0 then
                local h = char:FindFirstChild("HumanoidRootPart")
                if h then
                    local d = (h.Position - myPos).Magnitude
                    if d <= maxDist then
                        local pos, onS = Camera:WorldToViewportPoint(h.Position)
                        if onS then
                            local mag = (Vector2.new(pos.X, pos.Y) - c).Magnitude
                            if mag <= maxFOV and mag < bd then
                                local part = Config.AimTargetPart == "Head" and char:FindFirstChild("Head") or h
                                if part then bd = mag; best = part end
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Вечный день
RunService.Heartbeat:Connect(function()
    if Config.AlwaysDay then
        pcall(function()
            Lighting.ClockTime = 14
            Lighting.Brightness = 3
            Lighting.GlobalShadows = false
            Lighting.FogStart = 0; Lighting.FogEnd = 1000000
            for _, atm in ipairs(Lighting:GetChildren()) do
                if atm:IsA("Atmosphere") then atm.Density = 0; atm.Haze = 0 end
            end
        end)
    end
end)

local Window = WindUI:CreateWindow({
    Title = "FAST SURVIVAL v1.0",
    Author = "NEXUS",
    Folder = "FastSurvival",
    Theme = "Dark",
    Size = UDim2.fromOffset(450, 380),
})
Window:SetToggleKey(Enum.KeyCode.RightShift)

local AimTab = Window:Tab({ Title = "Aimbot", Icon = "crosshair" })
local EspTab = Window:Tab({ Title = "ESP", Icon = "eye" })
local WorldTab = Window:Tab({ Title = "World", Icon = "world" })

-- ВКЛАДКА АИМБОТ
AimTab:Toggle({ Title = "Аимбот", Value = false, Callback = function(s) Config.Aim = s; AimCircle.Visible = s end })
AimTab:Dropdown({ Title = "Куда целиться", Values = { "Head", "HumanoidRootPart" }, Value = "Head", Callback = function(v) Config.AimTargetPart = v end })
AimTab:Slider({ Title = "FOV (Радиус)", Value = { Min = 10, Max = 800, Default = 150 }, Callback = function(v) Config.AimRadius = v end })
AimTab:Slider({ Title = "Дальность работы", Value = { Min = 50, Max = 5000, Default = 500 }, Callback = function(v) Config.AimDistance = v end })
AimTab:Dropdown({ Title = "Цвет кружка", Values = { "Синий", "Радужный", "Белый" }, Value = "Синий", Callback = function(v) Config.AimColor = v; UpdateColors() end })

-- ВКЛАДКА ESP
EspTab:Toggle({ Title = "Player Boxes", Value = false, Callback = function(s) Config.EspBoxes = s end })
EspTab:Dropdown({ Title = "Цвет Боксов", Values = { "Синий", "Радужный", "Белый" }, Value = "Синий", Callback = function(v) Config.EspBoxColor = v end })
EspTab:Toggle({ Title = "Name Tags (Ники)", Value = false, Callback = function(s) Config.EspNames = s end })
EspTab:Toggle({ Title = "Health Bar (ХП)", Value = false, Callback = function(s) Config.EspHP = s end })
EspTab:Toggle({ Title = "Distance Info (Дистанция)", Value = false, Callback = function(s) Config.EspDist = s end })
EspTab:Slider({ Title = "Макс. Дистанция ESP", Value = { Min = 100, Max = 10000, Default = 3000 }, Callback = function(v) Config.EspDistance = v end })

-- ВКЛАДКА МИР
WorldTab:Toggle({ Title = "Вечный День", Value = false, Callback = function(s) Config.AlwaysDay = s end })

-- Отрисовка
local PlayerESP = {}

RunService.RenderStepped:Connect(function()
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myHrp and myHrp.Position or Vector3.zero
    local vpSize = Camera.ViewportSize
    local screenCenter = Vector2.new(vpSize.X / 2, vpSize.Y / 2)

    UpdateColors()

    if AimCircle.Visible then 
        AimCircle.Position = screenCenter
        AimCircle.Radius = Config.AimRadius
    end

    if Config.Aim then
        local t = GetClosestTarget(Config.AimRadius, Config.AimDistance)
        if t then Camera.CFrame = CFrame.new(Camera.CFrame.Position, t.Position) end
    end

    -- Отрисовка Игроков
    for player, _ in pairs(PlayerESP) do
        if not player.Parent or not player.Character then
            for _, l in pairs(PlayerESP[player].box) do l:Remove() end
            PlayerESP[player].text:Remove()
            PlayerESP[player].hpBg:Remove()
            PlayerESP[player].hpBar:Remove()
            PlayerESP[player] = nil
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and not PlayerESP[p] then
            local d = { box = {}, text = Drawing.new("Text"), hpBg = Drawing.new("Line"), hpBar = Drawing.new("Line") }
            for i=1,4 do local l = Drawing.new("Line"); l.Thickness = 1.5; table.insert(d.box, l) end
            d.text.Size = 13; d.text.Center = true; d.text.Outline = true; d.text.Color = COLOR_WHITE
            d.hpBg.Thickness = 3; d.hpBg.Color = Color3.fromRGB(0,0,0)
            d.hpBar.Thickness = 2
            PlayerESP[p] = d
        end
    end

    -- Рендер Игроков
    for p, d in pairs(PlayerESP) do
        local isR = false
        if myHrp and p.Character then
            local char = p.Character
            local head = char:FindFirstChild("Head")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            local hum = char:FindFirstChildOfClass("Humanoid")
            if head and hrp and hum then
                local dist = (hrp.Position - myPos).Magnitude
                if dist <= Config.EspDistance then 
                    local tp, on1 = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,0.5,0))
                    local bp, on2 = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,2,0))
                    if on1 and on2 then
                        local h = math.abs(tp.Y - bp.Y); local w = h * 0.6
                        local x = tp.X - (w/2); local y = tp.Y

                        -- Цвет боксов
                        local boxColor = COLOR_WHITE
                        if Config.EspBoxColor == "Синий" then boxColor = COLOR_BLUE
                        elseif Config.EspBoxColor == "Радужный" then boxColor = Color3.fromHSV((tick() * 0.5) % 1, 1, 1) end
                        
                        if Config.EspBoxes then
                            d.box[1].From = Vector2.new(x, y); d.box[1].To = Vector2.new(x+w, y)
                            d.box[2].From = Vector2.new(x+w, y); d.box[2].To = Vector2.new(x+w, y+h)
                            d.box[3].From = Vector2.new(x+w, y+h); d.box[3].To = Vector2.new(x, y+h)
                            d.box[4].From = Vector2.new(x, y+h); d.box[4].To = Vector2.new(x, y)
                            for _, l in pairs(d.box) do l.Visible = true; l.Color = boxColor end
                        else
                            for _, l in pairs(d.box) do l.Visible = false end
                        end
                        
                        -- Ники и Дистанция (Всегда белые)
                        d.text.Visible = (Config.EspNames or Config.EspDist)
                        if d.text.Visible then
                            local name = Config.EspNames and p.Name or ""
                            local distTxt = Config.EspDist and (" [" .. math.floor(dist) .. "m]") or ""
                            d.text.Text = name .. distTxt
                            d.text.Position = Vector2.new(tp.X, y - 16)
                        end

                        -- Полоска HP
                        if Config.EspHP then
                            local hpPct = hum.Health / hum.MaxHealth
                            d.hpBg.From = Vector2.new(x - 6, y); d.hpBg.To = Vector2.new(x - 6, y + h)
                            d.hpBar.From = Vector2.new(x - 6, y + h - (h * hpPct)); d.hpBar.To = Vector2.new(x - 6, y + h)
                            d.hpBar.Color = Color3.fromHSV(hpPct * 0.3, 1, 1)
                            d.hpBg.Visible = true; d.hpBar.Visible = true
                        else
                            d.hpBg.Visible = false; d.hpBar.Visible = false
                        end
                        isR = true
                    end
                end
            end
        end
        if not isR then 
            for _, l in pairs(d.box) do l.Visible = false end
            d.text.Visible = false 
            d.hpBg.Visible = false; d.hpBar.Visible = false
        end
    end
end)

WindUI:Notify({ Title = "FAST SURVIVAL v1.0", Content = "Скрипт загружен. Погнали!", Duration = 5 })
