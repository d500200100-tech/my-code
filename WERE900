local function CreateUltimateEsp(player)
if player == LocalPlayer then return end
-- Элементы 2D боксов и линий на экране смартфона
local boxStroke = Instance.new("BoxHandleAdornment")
boxStroke.AlwaysOnTop = true
boxStroke.ZIndex = 6
boxStroke.Transparency = 0.5
local lineGui = Instance.new("BillboardGui")
lineGui.Size = UDim2.new(0, 2, 0, 1000)
lineGui.AlwaysOnTop = true
local lineFrame = Instance.new("Frame", lineGui)
lineFrame.Size = UDim2.new(1,0,1,0)
lineFrame.BorderSizePixel = 0
lineFrame.BackgroundTransparency = 0.5
-- Вертикальное ХП бар прямо рядом с боксом
local hpGui = Instance.new("BillboardGui")
hpGui.Size = UDim2.new(0, 5, 0, 45)
hpGui.AlwaysOnTop = true
hpGui.ExtentsOffset = Vector3.new(-2.5, 0, 0) -- Слева от тела
local hpBack = Instance.new("Frame", hpGui)
hpBack.Size = UDim2.new(1,0,1,0)
hpBack.BackgroundColor3 = Color3.fromRGB(40,0,0)
hpBack.BorderSizePixel = 0
local hpFill = Instance.new("Frame", hpBack)
hpFill.Size = UDim2.new(1,0,1,0)
hpFill.BackgroundColor3 = Color3.fromRGB(0,255,100)
hpFill.BorderSizePixel = 0
game:GetService("RunService").Heartbeat:Connect(function()
if Config.Esp and player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
local root = player.Character.HumanoidRootPart
local dist = (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude
if dist <= Config.EspDistance then
local isTeammate = (player.Team == LocalPlayer.Team)
local color = isTeammate and Color3.fromRGB(0, 150, 255) or Color3.fromRGB(255, 50, 50)
-- Отрисовка 2D бокса вокруг тела
boxStroke.Parent = root
boxStroke.Adornee = root
boxStroke.Size = Vector3.new(3.8, 5.5, 3.8)
boxStroke.Color3 = color
-- Лазерная Трейсер-Линия к ногам
lineGui.Parent = root
lineGui.Adornee = root
lineFrame.BackgroundColor3 = color
-- Обновление вертикального ХП бара
hpGui.Parent = root
hpGui.Adornee = root
local healthPct = player.Character.Humanoid.Health / player.Character.Humanoid.MaxHealth
hpFill.Size = UDim2.new(1, 0, healthPct, 0)
hpFill.Position = UDim2.new(0, 0, 1 - healthPct, 0)
else
boxStroke.Parent = nil lineGui.Parent = nil hpGui.Parent = nil
end
else
boxStroke.Parent = nil lineGui.Parent = nil hpGui.Parent = nil
end
end)
end
for _, p in pairs(Players:GetPlayers()) do CreateUltimateEsp(p) end
Players.PlayerAdded:Connect(CreateUltimateEsp)
