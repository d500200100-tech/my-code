local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera
local Config = {
    SafeBlink = false, InfJump = false,
    Aim = false, AimRadius = 110,
    Silent = false, SilentRadius = 160,
    OneShot = false, NoRecoil = false,
    Esp = false, EspDistance = 500
}

local function GetClosestPlayerInCircle(maxRadius)
    local target, shortestDistance = nil, maxRadius
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            if p.Team ~= LocalPlayer.Team then
                local pos, onScreen = Camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
                if onScreen then
                    local distance = (Vector2.new(pos.X, pos.Y) - Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)).Magnitude
if distance < shortestDistance then target = p shortestDistance = distance end
end
end
end
end
return target
end
