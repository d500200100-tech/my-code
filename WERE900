-- ХУКИ ВЫСТРЕЛОВ И ОТДАЧИ
-- ===========================================================================
local gHook
gHook = hookmetamethod(game, "__namecall", function(self, ...)
local args = {...}
local method = getnamecallmethod()
if method == "FireServer" and (self.Name:lower():find("shoot") or self.Name:lower():find("hit") or self.Name:lower():find("bullet")) then
local targetPlayer = GetClosestPlayerInCircle(Config.SilentRadius)
if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Head") then
local head = targetPlayer.Character.Head
if Config.OneShot then
for i = 1, 10 do if typeof(args) == "Vector3" then args = head.Position end gHook(self, unpack(args)) end
elseif Config.Silent then
if typeof(args) == "Vector3" then args = head.Position end
end
return gHook(self, unpack(args))
end
end
if Config.NoRecoil and method == "FireServer" and (self.Name:lower():find("recoil") or self.Name:lower():find("sway") or self.Name:lower():find("shake")) then
return nil
end
return gHook(self, ...)
end)
